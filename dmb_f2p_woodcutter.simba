{$I WaspLib/main.simba}


// Log in, or back in after a disconnect, with WaspLib's own login: it clicks "Play" on the
// welcome screen (the Jagex launcher - no password needed), "Ok" after a disconnect and "Click
// here to play" in the lobby, and does nothing when we're already logged in. With no account
// saved in WaspLib it would stop the script ("No profiles declared"), so then it gets an empty
// one and only clicks through those screens.
var
  LoginFails: Integer;

function DoLoginSafe(): Boolean;
var
  p: TProfile;
begin
  if Client.IsLoggedIn() then
    Exit(True);
  try
    if Length(Profiles) > 0 then
      Result := Login.DoLogin()
    else
    begin
      p.Name := 'no password';
      p.Active := True;
      Result := Login.DoLogin(p);
    end;
  except
    Logger.Warn('Login: ' + GetExceptionMessage());
  end;
  Result := Result or Client.IsLoggedIn();
  if Result then
  begin
    LoginFails := 0;
    Logger.Info('Login: logged in.');
    Exit;
  end;
  Inc(LoginFails);
  Logger.Warn('Login: could not log in (try ' + ToStr(LoginFails) + ' of 5).');
  if LoginFails >= 5 then
    raise 'Could not log back in 5 times in a row. If the game asks for a password, save your account in WaspLib (or log in yourself and start the script again).';
  Sleep(5000, 10000);
end;

// =====================================================================================
//  DMB's F2P Woodcutter                                      Simba 2.0 + WaspLib
// =====================================================================================
// FILES (all in Scripts\)
//   dmb_f2p_woodcutter.simba  this script
//   Logs go to Data\Logs\DMB's F2P Woodcutter\
//
// HOW TO USE
//   Start it logged in (or at the login screen). It reads your Woodcutting and Firemaking
//   levels, then opens the settings window. Pick the place, the tree and what to do with the
//   logs, press Start. It walks there from anywhere in the F2P area.
//   While it runs, RuneLite ignores your own mouse and keyboard.
//
// WHAT TO DO WITH THE LOGS (settings)
//   Cut and bank   full inventory -> the place's bank -> back
//   Cut and drop   full inventory -> drop the logs (shift-drop) -> carry on
//   Cut and burn   full inventory -> light ONE fire with a tinderbox, then use the logs on
//                  that fire: the game puts them all on, one after another (Firemaking level
//                  for the logs needed) -> carry on. The next inventory goes on the same fire
//                  while it's still burning, otherwise it lights a new one. "You can't light a
//                  fire here." -> it steps a few tiles and tries again. Feeding a fire turns it
//                  into a Forester's Campfire; "There's a Forester's Campfire nearby..." -> if
//                  it's ours it puts the logs on that, otherwise it moves ~10 tiles away.
//
// PLACES                  TREES (the ones WaspLib's data has there are used)    BANK
//   Lumbridge             trees, oaks                                           Lumbridge Castle (top floor)
//   Draynor Village       trees, oaks, willows                                  Draynor
//   Varrock West          trees, oaks                                           Varrock West
//   Edgeville             yews                                                  Edgeville
//   Local area            any of the four (Cut and drop / Cut and burn only): the trees within
//                         15 tiles of where you stand when you press Start - no bank
//   The log says how many of the chosen trees WaspLib found there; none = it stops and says so.
//
// TREES                   WOODCUTTING   FIREMAKING (burning the logs)
//   Tree (normal)         1             1
//   Oak                   15            15
//   Willow                30            30
//   Yew                   60            60
//   Trees/places you lack the level for say LOCKED in the settings and won't start.
//
// ITEMS
//   Whatever is in your inventory when you press Start (except logs) is yours: it is never
//   banked, dropped or burnt - only the logs are.
//   Axe        the best one your Woodcutting level can use, in the inventory or worn; if
//              there's none it takes one out of the bank (never banked or dropped)
//   Tinderbox  burning only; taken out of the bank if missing (never banked or dropped)
//
// WHICH TREE IT CUTS: the nearest one of the chosen kind that isn't cut down. It keeps
//   chopping while the logs keep coming, and moves on as soon as the tree turns into a stump
//   (it checks the tree every few seconds) or after a while with no logs.
//
// PATIENCE: how long it keeps chopping one tree with no new log before trying another. At a
//   low level for the tree you fail a lot, so it waits longer (the tree isn't cut down - it
//   checks for the stump - you're just slow):
//                 base     0-9 levels over the tree   10-19 levels over   20+ over
//   Tree          20 s     20 s                       20 s                20 s
//   Oak           25 s     75 s                       50 s                25 s
//   Willow        30 s     90 s                       60 s                30 s
//   Yew           60 s     180 s                      120 s               60 s
//   While it waits it clicks the tree again every 15-20 s in case the chopping stopped.
//
// DEBUG (tick "Debug: turn off the level and item checks") - for testing the walking:
//   LOCKED trees start anyway, no axe / tinderbox only gives a warning.
//
// SAFETY: never into the Wilderness (Edgeville is close: the yews are south of the ditch);
//   every walk has a time limit and an 8 s stuck check; trees, banks and stairs are
//   WaspLib's own objects - no searching the screen.
// =====================================================================================

type
  ELogMode = enum(BANK, DROP, BURN);

  TCutPlace = record
    Name, BankName: String;
    Center, Bank: TPoint;           // game tiles: the middle of the trees, where to stand at the bank
    Radius: Integer;                // trees within this many tiles of Center
    Trees: TIntegerArray;           // indexes into TREE_NAMES
    Lumbridge: Boolean;             // the bank is upstairs in the castle
    Local: Boolean;                 // "Local area": the trees around where you start, no bank
  end;

  TTreeSpot = record
    Obj: TObject;
    Spot: TPoint;
    FreeAt: UInt64;                 // cut down / not reachable until then
  end;

  ECutState = enum(LOGIN, LEVEL_UP, TRAVEL, OPEN_BANK, BANK, DROP, BURN, CUT, NO_ACTIVITY, MAX_TIME, STOP);

const
  ANTIBAN_SLOWDOWN = 3;
  TOLL_COINS = 10;

var
  PLACES: array of TCutPlace;

  // tree kinds: the settings name, WaspLib object names, the log, levels, respawn and patience
  TREE_NAMES: TStringArray = ['Tree', 'Oak', 'Willow', 'Yew'];
  TREE_OBJECTS: array of TStringArray = [
    ['Tree', 'Dead tree', 'Evergreen tree', 'Evergreen'],
    ['Oak tree', 'Oak'],
    ['Willow tree', 'Willow'],
    ['Yew tree', 'Yew']
  ];
  TREE_LOGS: TStringArray = ['Logs', 'Oak logs', 'Willow logs', 'Yew logs'];
  TREE_WC_LEVELS: TIntegerArray = [1, 15, 30, 60];
  TREE_FM_LEVELS: TIntegerArray = [1, 15, 30, 60];
  TREE_RESPAWN: TIntegerArray = [15000, 15000, 15000, 60000];   // about, ms
  TREE_PATIENCE: TIntegerArray = [20000, 25000, 30000, 60000];  // no new log this long -> next tree

  AXES: TStringArray = ['Bronze axe', 'Iron axe', 'Steel axe', 'Black axe', 'Mithril axe',
                        'Adamant axe', 'Rune axe', 'Dragon axe', 'Crystal axe', 'Infernal axe',
                        '3rd age axe', 'Gilded axe'];
  AXE_LEVELS: TIntegerArray = [1, 1, 6, 11, 21, 31, 41, 61, 71, 61, 61, 41];
  // axes to take out of the bank, best first (F2P), with the Woodcutting level each needs
  BANK_AXES: TStringArray = ['Rune axe', 'Adamant axe', 'Mithril axe', 'Black axe', 'Steel axe',
                             'Iron axe', 'Bronze axe'];
  BANK_AXE_LEVELS: TIntegerArray = [41, 31, 21, 11, 6, 1, 1];

  // Lumbridge Castle (tested in the miner and fisher): ground-floor staircase, top floor
  LUMBRIDGE_STAIRS: TPoint = [12824, 37594];   // game (3206, 3209)
  TOP_STAIRS: TPoint = [64032, 37590];
  TOP_BANK: TPoint = [64036, 37550];

  // walker watchdog
  WalkDeadline, WalkLogAt, WalkStallSince: UInt64;
  WalkStallSpot: TPoint;
  WildernessHit: Boolean;

procedure AddPlace(name, bankName: String; cx, cy, radius, bx, by: Integer; trees: TIntegerArray; lumbridge: Boolean);
var
  p: TCutPlace;
begin
  p.Name := name;
  p.BankName := bankName;
  p.Center := Point(cx, cy);
  p.Radius := radius;
  p.Bank := Point(bx, by);
  p.Trees := trees;
  p.Lumbridge := lumbridge;
  PLACES += p;
end;

// The tree centres are approximate: WaspLib's data says where the real trees are (the log
// says how many it found). More places / better centres: post coordinates in a GitHub issue.
procedure SetupPlaces();
begin
  AddPlace('Lumbridge',       'Lumbridge Castle (top floor)', 3200, 3240, 20, 3206, 3209, [0, 1],    True);
  AddPlace('Draynor Village', 'Draynor',                      3087, 3236, 14, 3092, 3243, [0, 1, 2], False);
  AddPlace('Varrock West',    'Varrock West',                 3165, 3415, 16, 3185, 3436, [0, 1],    False);
  AddPlace('Edgeville',       'Edgeville',                    3087, 3475, 12, 3094, 3492, [3],       False);
  // last on the list: only offered with Cut and drop / Cut and burn (there's no bank)
  AddPlace('Local area',      '',                             0, 0, 15, 0, 0,             [0, 1, 2, 3], False);
  PLACES[High(PLACES)].Local := True;
end;

// ---------------------------------------------------------------- helpers (from the miner/fisher)

// Game tile -> WaspLib map pixels (the same numbers the coordinate finder shows)
function Tile(x, y: Integer): TPoint;
begin
  Result := Point(x * 4, 50430 - y * 4);
end;

// North of the Wilderness ditch (game y 3523 and up)? Map pixels.
function InWilderness(p: TPoint): Boolean;
var
  gx, gy: Integer;
begin
  if (p.X = 0) and (p.Y = 0) then
    Exit(False);
  gx := p.X div 4;
  gy := (50430 - p.Y) div 4;
  Result := (gx >= 2940) and (gx <= 3400) and (gy >= 3523) and (gy <= 3970);
end;

// East of the Lumbridge / Al Kharid fence?
function InAlKharid(p: TPoint): Boolean;
var
  gx, gy: Integer;
begin
  if (p.X = 0) and (p.Y = 0) then
    Exit(False);
  gx := p.X div 4;
  gy := (50430 - p.Y) div 4;
  Result := (gx >= 3268) and (gy >= 3130) and (gy <= 3330);
end;

// A window popped up that the script didn't open (a misclick on a poll booth, a notice board...):
// close it with its X and carry on. The bank, deposit box, anvil and jewellery screens are left
// alone. Uses WaspLib's general main-screen window check (MSInterface).
var
  StrayCheckAt: UInt64;

function CloseStrayInterface(force: Boolean = False): Boolean;
var
  x: TBox;
begin
  if (not force) and (GetTimeRunning() < StrayCheckAt) then
    Exit;
  StrayCheckAt := GetTimeRunning() + 1500;
  try
    if Bank.IsOpen() or DepositBox.IsOpen() or Anvil.IsOpen() or GoldScreen.IsOpen() or SilverScreen.IsOpen() then
      Exit;
    if not MSInterface.IsOpen() then
      Exit;
    x := MSInterface.GetCloseButton();
    if x = Default(TBox) then
      Exit;
    Logger.Warn('A window popped up (a misclick on a poll booth or similar) - closing it.');
    Mouse.Click(x, EMouseButton.LEFT);
    Result := SleepUntil(not MSInterface.IsOpen(), 100, 1500);
  except
  end;
end;

// An item left selected in the inventory (e.g. after a misclick) makes every click on the
// game "Use item ->", and the bank / objects can't be opened. Unselect it.
procedure UnselectItem();
var
  sel: Integer;
begin
  try
    sel := Inventory.GetSelected();
  except
    Exit;
  end;
  if sel < 0 then
    Exit;
  Logger.Info('An item in the inventory was selected (slot ' + ToStr(sel + 1) + ') - unselecting it.');
  Mouse.Click(Inventory.Slots.Box(sel), EMouseButton.LEFT);
  SleepUntil(Inventory.GetSelected() < 0, 100, 1500);
  Mouse.Move(Point(MainScreen.Bounds.Center.X + Random(-80, 80), MainScreen.Bounds.Center.Y + Random(-60, 60)));
end;


// Is this walk hopeless? Logged out (the walker would keep "walking" on the login screen), or
// our position jumping tens of tiles back and forth (a bad reading, e.g. while logged out or
// on a loading screen). Then the walk is stopped and the main loop logs back in / retries.
var
  SaneCheckAt: UInt64;
  LastSanePos: TPoint;
  PosJumps: Integer;

function WalkLooksWrong(position: TPoint): Boolean;
begin
  if GetTimeRunning() >= SaneCheckAt then
  begin
    SaneCheckAt := GetTimeRunning() + 2000;
    if not Client.IsLoggedIn() then
    begin
      Logger.Warn('Walk: we are logged out - stopping the walk (the script logs back in).');
      LastSanePos := Point(0, 0);
      Exit(True);
    end;
  end;

  if (position.X = 0) and (position.Y = 0) then
    Exit;
  if (LastSanePos.X <> 0) and (position.DistanceTo(LastSanePos) > 25 * RSTranslator.TILE_SIZE) then
  begin
    Inc(PosJumps);
    if PosJumps >= 4 then
    begin
      Logger.Warn('Walk: our position keeps jumping around (now [' + ToStr(position.X) + ', ' +
                  ToStr(position.Y) + ']) - the reading is off, stopping this walk.');
      PosJumps := 0;
      LastSanePos := Point(0, 0);
      Exit(True);
    end;
  end
  else
    PosJumps := 0;
  LastSanePos := position;
end;

procedure TWalker.Watchdog(walker: PRSWalker; position, destination: TPoint);
begin
  CloseStrayInterface();
  if WalkLooksWrong(position) then
  begin
    walker^.Walking := False;
    WalkDeadline := 0;
    Exit;
  end;
  // never into the Wilderness (a destination hundreds of tiles away is a bad point from
  // WaspLib's walker, not a real walk - only trust destinations near us)
  if InWilderness(position) or
     (InWilderness(destination) and (position.DistanceTo(destination) <= 150 * RSTranslator.TILE_SIZE)) then
  begin
    Logger.Error('Walk: this walk goes into the Wilderness - stopping it (at [' + ToStr(position.X) + ', ' +
                 ToStr(position.Y) + '], heading to [' + ToStr(destination.X) + ', ' + ToStr(destination.Y) + ']).');
    WildernessHit := True;
    walker^.Walking := False;
    WalkDeadline := 0;
    Exit;
  end;

  if GetTimeRunning() > WalkLogAt then
  begin
    WalkLogAt := GetTimeRunning() + 3000;
    Logger.Info('Walking: at [' + ToStr(position.X) + ', ' + ToStr(position.Y) + '], next point ' +
                ToStr(Round(position.DistanceTo(destination) / RSTranslator.TILE_SIZE)) + ' tiles away.');
  end;

  if (WalkDeadline > 0) and (GetTimeRunning() > WalkDeadline) then
  begin
    Logger.Warn('Walk: took too long, stopping it.');
    walker^.Walking := False;
    WalkDeadline := 0;
    Exit;
  end;

  // stuck against something: not moved a tile in 8 s -> stop
  if WalkDeadline > 0 then
  begin
    if position.DistanceTo(WalkStallSpot) >= RSTranslator.TILE_SIZE then
    begin
      WalkStallSpot := position;
      WalkStallSince := GetTimeRunning();
    end
    else if GetTimeRunning() - WalkStallSince > 8000 then
    begin
      Logger.Warn('Walk: not moved for 8 s at [' + ToStr(position.X) + ', ' + ToStr(position.Y) +
                  '] (stuck on something), stopping this walk.');
      walker^.Walking := False;
      WalkDeadline := 0;
    end;
  end;
end;

// Start the watchdog's time limit + stall check for a walk WaspLib does itself (bank, furnace).
procedure GuardWalk(ms: Integer);
begin
  WalkStallSpot := Map.Position();
  WalkStallSince := GetTimeRunning();
  WalkDeadline := GetTimeRunning() + ms;
end;

// WaspLib's walker with a time limit. True when we end within `reachTiles` of `dest`.
function WebWalkRaw(dest: TPoint; ms, reachTiles: Integer): Boolean;
var
  path, dense: TPointArray;
  i, k, steps: Integer;
begin
  if InWilderness(dest) then
  begin
    Logger.Error('Walk: refusing to walk into the Wilderness.');
    WildernessHit := True;
    Exit(False);
  end;

  GuardWalk(ms);
  try
    // fill in a point every 10 tiles: the minimap only reaches ~15 tiles
    path := Map.Walker.GetPath(Map.Position(), dest, 0.3);
    for i := 0 to High(path) do
    begin
      if i > 0 then
      begin
        steps := Ceil(path[i - 1].DistanceTo(path[i]) / (10 * RSTranslator.TILE_SIZE));
        for k := 1 to steps - 1 do
          dense += Point(path[i - 1].X + (path[i].X - path[i - 1].X) * k div steps,
                         path[i - 1].Y + (path[i].Y - path[i - 1].Y) * k div steps);
      end;
      dense += path[i];
    end;
    if dense <> [] then
      Map.Walker.WalkPath(dense, 8)
    else
      Map.Walker.WebWalk(dest, 8, 0.3);
  except
    Logger.Warn('Walk: WaspLib''s walker failed: ' + GetExceptionMessage());
  end;
  WalkDeadline := 0;
  Result := Map.Position().DistanceTo(dest) <= reachTiles * RSTranslator.TILE_SIZE;
end;

// Minimap click `tiles` tiles away in a world direction (dx east, dy north = -1...).
procedure StepDirection(dx, dy, tiles: Integer);
var
  base, mm: TPoint;
begin
  base := Point(20000, 20000);
  mm := TWalker.Point2MM(base, Point(base.X + dx * tiles * 4, base.Y + dy * tiles * 4), Minimap.CompassRadians);
  Mouse.Click(Point(mm.X + Random(-2, 2), mm.Y + Random(-2, 2)), EMouseButton.LEFT);
  Sleep(600, 900);
  SleepUntil(not Minimap.IsPlayerMoving(), 150, 8000);
end;

// The object called one of `names` that WaspLib knows closest to `spot` (within maxTiles).
function NearestObject(names: TStringArray; spot: TPoint; maxTiles: Integer; out obj: TObject): Boolean;
var
  all: TMapObjectDataArray;
  single: TMapObjectData;
  name: String;
  i, j, bj: Integer;
  best, d: Double;
begin
  best := 1000000000;
  bj := -1;
  for name in names do
  begin
    try
      all := MapObjects.GetByName(name);
    except
      Logger.Warn('WaspLib objects: looking up "' + name + '" failed: ' + GetExceptionMessage());
      Continue;
    end;
    for i := 0 to High(all) do
      for j := 0 to High(all[i].Coordinates) do
      begin
        d := all[i].Coordinates[j].DistanceTo(spot);
        if d < best then
        begin
          best := d;
          single := all[i];
          bj := j;
        end;
      end;
  end;

  if bj = -1 then
  begin
    Logger.Warn('WaspLib objects: no "' + names[0] + '" in the loaded map at all.');
    Exit(False);
  end;
  if best > maxTiles * RSTranslator.TILE_SIZE then
  begin
    Logger.Warn('WaspLib objects: nearest "' + single.Name + '" is ' + ToStr(Round(best / RSTranslator.TILE_SIZE)) +
                ' tiles away (want ' + ToStr(maxTiles) + ').');
    Exit(False);
  end;

  single.Coordinates := [single.Coordinates[bj]];
  if bj <= High(single.Rotations) then
    single.Rotations := [single.Rotations[bj]];
  obj := TObject.Create(Map.Walker, single);
  Result := True;
end;

procedure CancelMenu();
begin
  if not ChooseOption.IsOpen() then
    Exit;
  if not ChooseOption.Select(['Cancel', 'ancel']) then
    ChooseOption.Close();
  Sleep(80, 200);
end;

// Use the staircase WaspLib knows next to `spot`. `wanted` are bits of the menu line to pick,
// best first (the menu reader garbles letters, so short bits: 'op-floor', 'limb-up'...). The
// first menu line containing the earliest bit wins. The log says which line it clicked.
function UseStaircase(spot: TPoint; wanted: TStringArray): Boolean;
var
  stairs: TObject;
  opt, pick: TOption;
  menu, w: String;
  hovered, found: Boolean;
begin
  if NearestObject(['Staircase'], spot, 6, stairs) then
    try
      hovered := stairs.Hover([]);
      if not hovered then
        hovered := stairs.WalkHover([]);
    except
      Logger.Warn('Stairs: ' + GetExceptionMessage());
    end
  else
    Logger.Warn('Stairs: WaspLib knows no staircase here.');

  if not hovered then
  begin
    Logger.Warn('Stairs: could not hover the staircase.');
    Exit;
  end;

  Mouse.Click(EMouseButton.RIGHT);
  if not SleepUntil(ChooseOption.IsOpen(), 50, 1500) then
  begin
    Logger.Warn('Stairs: the right-click menu did not open.');
    Exit;
  end;
  Sleep(150, 350);

  for opt in ChooseOption.GetOptions() do
    menu += '[' + opt.Text + '] ';
  found := False;
  for w in wanted do
  begin
    for opt in ChooseOption.GetOptions() do
      if Pos(Lowercase(w), Lowercase(opt.Text)) > 0 then
      begin
        pick := opt;
        found := True;
        Break;
      end;
    if found then
      Break;
  end;

  if not found then
  begin
    Logger.Warn('Stairs: none of ' + ToStr(wanted) + ' in the menu. It says: ' + menu);
    CancelMenu();
    Exit;
  end;
  Logger.Info('Stairs: clicking "' + pick.Text + '" (menu: ' + menu + ').');
  ChooseOption.Select(pick);
  Sleep(2500, 3500);
  Result := True;
end;

// Which floor are we on? Upper floors sit to the right on WaspLib's map.
function CurrentFloor(): Integer;
var
  me: TPoint;
begin
  me := Map.Position();
  if (me.X = 0) and (me.Y = 0) then
    Exit(-1);
  Result := me.X div RSTranslator.MapWidth;
end;

function Here(): String;
var
  me: TPoint;
begin
  me := Map.Position();
  Result := '[' + ToStr(me.X) + ', ' + ToStr(me.Y) + ']';
end;

procedure SlowAntiban();
var
  i: Integer;
begin
  for i := 0 to High(Antiban.Tasks) do
  begin
    Antiban.Tasks[i].Interval := Antiban.Tasks[i].Interval * ANTIBAN_SLOWDOWN;
    Antiban.Tasks[i].Countdown.Start(Round(Antiban.Tasks[i].Interval * Random(60, 100) / 100));
  end;
  for i := 0 to High(Antiban.WalkTasks) do
  begin
    Antiban.WalkTasks[i].Interval := Antiban.WalkTasks[i].Interval * ANTIBAN_SLOWDOWN;
    Antiban.WalkTasks[i].Countdown.Start(Round(Antiban.WalkTasks[i].Interval * Random(60, 100) / 100));
  end;
end;

procedure SetClientInputLocked(locked: Boolean);
begin
  if RemoteInput.Target = nil then
    Exit;
  EIOS_SetMouseInputEnabled(RemoteInput.Target, not locked);
  EIOS_SetKeyboardInputEnabled(RemoteInput.Target, not locked);
  if locked then
    Logger.Info('Client locked: your real mouse and keyboard are ignored by RuneLite.')
  else
    Logger.Info('Client unlocked.');
end;

// Coins in the inventory: the size of the stack (Count would only count the slots).
function CoinCount(): Integer;
var
  i: Integer;
begin
  for i := 1 to 3 do
  begin
    Result := Max(Result, Inventory.Items.CountEx('Coins'));
    if Result >= TOLL_COINS then
      Break;
    Sleep(300, 500);
  end;
end;

// ---------------------------------------------------------------- Lumbridge Castle bank

// ---------------------------------------------------------------- Al Kharid toll gate (from the smelter)
// Any walk that crosses the Lumbridge / Al Kharid fence goes through the toll gate first, by
// trying it: "Open" (free with Prince Ali Rescue), the guard / "Pay-toll" with 10+ coins,
// turning the camera if the gate can't be seen. Not let through: the long way round the fence.

var
  TOLL_GATE: TPoint = [13068, 37522];
  GATE_WEST: TPoint = [13060, 37522];   // game (3265, 3227)
  GATE_EAST: TPoint = [13076, 37522];   // game (3269, 3227)
  // the long way round the fence (no coins, no Prince Ali Rescue), game tiles
  LONG_WAY: TPointArray = [
    [3265, 3227], [3260, 3236], [3259, 3246], [3252, 3254], [3251, 3264], [3246, 3273],
    [3240, 3281], [3239, 3291], [3239, 3301], [3245, 3311], [3251, 3319], [3261, 3322],
    [3269, 3329], [3279, 3330], [3275, 3319], [3275, 3309], [3275, 3299], [3269, 3291],
    [3269, 3281], [3269, 3271], [3269, 3261], [3269, 3251], [3269, 3241], [3269, 3231],
    [3269, 3227]
  ];

// Coins in the inventory (the stack size).
function GateCoins(): Integer;
var
  i: Integer;
begin
  for i := 1 to 3 do
  begin
    Result := Max(Result, Inventory.Items.CountEx('Coins'));
    if Result >= 10 then
      Break;
    Sleep(300, 500);
  end;
end;

// Right-click the gate and pick the first menu line containing one of `wanted`. `menu` gets the
// whole menu (for the log). False = none of them was there (the menu is closed again).
function GateMenu(gate: TObject; wanted: TStringArray; out menu: String): Boolean;
var
  opt, pick: TOption;
  w: String;
  hovered, found: Boolean;
  tries: Integer;
begin
  menu := '';
  // a few tries; between them turn the camera a quarter turn, in case the gate is hidden
  // behind something or seen edge-on
  for tries := 1 to 4 do
  begin
    try
      hovered := gate.Hover([]);
    except
      Logger.Warn('Gate: ' + GetExceptionMessage());
    end;
    if hovered then
      Break;
    if tries < 4 then
    begin
      Logger.Info('Gate: can''t hover it from this angle - turning the camera.');
      Minimap.CompassDegrees := Round(Minimap.CompassDegrees + 90 + Random(-15, 15)) mod 360;
      Sleep(600, 1000);
    end;
  end;
  if not hovered then
  begin
    Logger.Warn('Gate: could not hover the gate (tried 4 camera angles).');
    Exit;
  end;

  Logger.Info('Gate: hovering it, hover text: "' + MainScreen.UpText + '".');

  // the hover text is read reliably ("Open Gate"); the right-click menu reader garbles letters
  // ("Ooen Gate"). So when the left-click option is already the one we want, just left-click.
  for w in wanted do
    if MainScreen.IsUpText([w], False, 0.85, 50) then
    begin
      Logger.Info('Gate: left-clicking it ("' + MainScreen.UpText + '").');
      Mouse.Click(EMouseButton.LEFT);
      Exit(True);
    end;

  Mouse.Click(EMouseButton.RIGHT);
  if not SleepUntil(ChooseOption.IsOpen(), 50, 1500) then
  begin
    Logger.Warn('Gate: the right-click menu did not open.');
    Exit;
  end;
  Sleep(150, 350);
  for opt in ChooseOption.GetOptions() do
    menu += '[' + opt.Text + '] ';
  for w in wanted do
  begin
    for opt in ChooseOption.GetOptions() do
      if Pos(Lowercase(w), Lowercase(opt.Text)) > 0 then
      begin
        pick := opt;
        found := True;
        Break;
      end;
    if found then
      Break;
  end;
  if not found then
  begin
    Logger.Info('Gate: no ' + ToStr(wanted) + ' in the menu: ' + menu);
    CancelMenu();
    Exit;
  end;
  Logger.Info('Gate: clicking "' + pick.Text + '" (menu: ' + menu + ').');
  ChooseOption.Select(pick);
  Result := True;
end;

// Through the toll gate, from whichever side we're on - by trying it:
//   1. "Open": with Prince Ali Rescue done it just lets us through (free).
//   2. Not through: a guard talking to us -> with 10+ coins answer yes (pays the toll).
//   3. Still not through: "Pay-toll" (free with Prince Ali Rescue, else needs 10 coins).
//   4. Still not through: we can't get through here (the caller walks the long way round).
function CrossTollGate(): Boolean;
var
  gate: TObject;
  approach: TPoint;
  wasInside: Boolean;
  coins: Integer;
  menu: String;
  endAt: UInt64;
begin
  wasInside := InAlKharid(Map.Position());
  if wasInside then
    approach := GATE_EAST
  else
    approach := GATE_WEST;
  Logger.Info('Gate: to the toll gate.');
  if not WebWalkRaw(approach, 240000, 2) then
  begin
    Logger.Warn('Gate: could not walk to the toll gate (we are at ' + Here() + ').');
    Exit;
  end;
  Map.Walker.WaitMoving();
  SleepUntil(not Minimap.IsPlayerMoving(), 150, 5000);
  Sleep(500, 900);

  if not NearestObject(['Gate', 'Toll gate'], TOLL_GATE, 5, gate) then
  begin
    Logger.Warn('Gate: WaspLib knows no gate here - assuming we can''t get through.');
    Exit;
  end;
  coins := GateCoins();
  Logger.Info('Gate: ' + ToStr(coins) + ' coins in the inventory.');

  // 1) Open (free with Prince Ali Rescue)
  if GateMenu(gate, ['Open', 'Ooen', 'pen Gate', 'en Gate'], menu) then
  begin
    if SleepUntil(InAlKharid(Map.Position()) <> wasInside, 300, 5000) then
    begin
      Logger.Info('Gate: through for free (Prince Ali Rescue done), now at ' + Here() + '.');
      Exit(True);
    end;

    // 2) the guard wants paying: answer yes when we have the coins, otherwise talk it out
    endAt := GetTimeRunning() + 8000;
    repeat
      if InAlKharid(Map.Position()) <> wasInside then
        Break;
      if Chat.ContainsContinue() then
        Chat.Continue()
      else if coins >= 10 then
        Chat.Options.Select('Yes', False)
      else if not Chat.Options.Select('No', False) then
        Sleep(200);
      Sleep(400, 700);
    until GetTimeRunning() > endAt;
    if SleepUntil(InAlKharid(Map.Position()) <> wasInside, 300, 3000) then
    begin
      Logger.Info('Gate: through (paid the guard), now at ' + Here() + '.');
      Exit(True);
    end;
  end;

  // 3) Pay-toll - tried even without coins: with Prince Ali Rescue done it may be free
  if GateMenu(gate, ['oll', 'Pay'], menu) then
    if SleepUntil(InAlKharid(Map.Position()) <> wasInside, 300, 8000) then
    begin
      Logger.Info('Gate: through (paid the toll), now at ' + Here() + '.');
      Exit(True);
    end;

  // 4) no way through here
  if coins < 10 then
    Logger.Warn('Gate: not let through and fewer than 10 coins - assuming we can''t get through.')
  else
    Logger.Warn('Gate: not let through (gate menu: ' + menu + ') - assuming we can''t get through.');
end;

// The long way round the fence (when the toll gate doesn't let us through).
function WalkLongWay(intoAlKharid: Boolean): Boolean;
var
  path: TPointArray;
  i, k, start: Integer;
  me: TPoint;
  best: Double;
begin
  // (written out plainly: the "if ... for ... else for ..." version left the path empty)
  SetLength(path, Length(LONG_WAY));
  for i := 0 to High(LONG_WAY) do
  begin
    k := i;
    if not intoAlKharid then
      k := High(LONG_WAY) - i;
    path[i] := Tile(LONG_WAY[k].X, LONG_WAY[k].Y);
  end;
  if Length(path) = 0 then
    Exit(False);

  me := Map.Position();
  best := 1000000000;
  for i := 0 to High(path) do
    if me.DistanceTo(path[i]) < best then
    begin
      best := me.DistanceTo(path[i]);
      start := i;
    end;
  if best > 15 * RSTranslator.TILE_SIZE then
  begin
    start := 0;
    if not WebWalkRaw(path[0], 240000, 4) then
      Exit;
  end;

  Logger.Info('Long way: walking round the fence.');
  for i := start to High(path) do
    if not WebWalkRaw(path[i], 40000, 3) then
    begin
      Logger.Warn('Long way: stuck at point ' + ToStr(i + 1) + '/' + ToStr(Length(path)) + '.');
      Exit;
    end;
  Result := InAlKharid(Map.Position()) = intoAlKharid;
end;

// WaspLib's walker with our time limit, through the toll gate first when the walk crosses the
// Lumbridge / Al Kharid fence. True when we end within `reachTiles` of `dest`.
function SafeWebWalk(dest: TPoint; ms, reachTiles: Integer): Boolean;
var
  me: TPoint;
  into: Boolean;
begin
  me := Map.Position();
  if (me.X <> 0) and (me.X < RSTranslator.MapWidth) and (dest.X < RSTranslator.MapWidth) and
     (InAlKharid(me) <> InAlKharid(dest)) and not InWilderness(dest) then
  begin
    into := InAlKharid(dest);
    if not CrossTollGate() then
    begin
      Logger.Info('Walk: the toll gate is no good - taking the long way round the fence.');
      if not WalkLongWay(into) then
      begin
        Logger.Warn('Walk: could not get past the Al Kharid fence (toll gate or the long way).');
        Exit(False);
      end;
    end;
  end;
  CloseStrayInterface(True);
  Result := WebWalkRaw(dest, ms, reachTiles);
  // a window popped up during the walk (misclick): close it and walk again, once
  if (not Result) and CloseStrayInterface(True) then
  begin
    Logger.Info('Walk: a window was in the way - closed it, walking again.');
    Result := WebWalkRaw(dest, ms, reachTiles);
  end;
end;


function OpenLumbridgeBank(): Boolean;
var
  booth: TObject;
begin
  if CurrentFloor() <> 2 then
  begin
    Logger.Info('Bank: to the Lumbridge Castle staircase.');
    if not SafeWebWalk(LUMBRIDGE_STAIRS, 180000, 3) then
    begin
      Logger.Warn('Bank: did not reach the staircase (we are at ' + Here() + ').');
      Exit;
    end;
    Map.Walker.WaitMoving();
    Logger.Info('Bank: climbing to the top floor.');
    if not UseStaircase(LUMBRIDGE_STAIRS, ['op-floor', 'top floor', 'floor', 'limb-up', 'limb-u']) then
      Exit;
    SleepUntil(CurrentFloor() in [1, 2], 300, 6000);
    if CurrentFloor() = 1 then
    begin
      Logger.Info('Bank: on the middle floor - climbing up once more.');
      UseStaircase(Point(LUMBRIDGE_STAIRS.X + RSTranslator.MapWidth, LUMBRIDGE_STAIRS.Y), ['limb-up', 'limb-u', 'op-floor']);
      SleepUntil(CurrentFloor() = 2, 300, 6000);
    end;
    if CurrentFloor() <> 2 then
    begin
      Logger.Warn('Bank: not on the top floor after climbing (we are at ' + Here() + ', floor ' + ToStr(CurrentFloor()) + ').');
      Exit;
    end;
  end;

  Logger.Info('Bank: opening the top-floor bank booth.');
  if not NearestObject(['Bank booth', 'Bank Booth'], TOP_BANK, 8, booth) then
    Exit;
  GuardWalk(45000);
  try
    Result := Bank.Open(booth, True);
  except
    Logger.Warn('Bank: ' + GetExceptionMessage());
  end;
  WalkDeadline := 0;
end;

function LeaveTopFloor(): Boolean;
begin
  Logger.Info('Travel: down the Lumbridge Castle stairs.');
  if not SafeWebWalk(TOP_STAIRS, 30000, 2) then
    StepDirection(0, 1, 9);
  if UseStaircase(TOP_STAIRS, ['ottom-floor', 'ottom', 'floor', 'limb-down', 'limb-d']) then
    SleepUntil(CurrentFloor() in [0, 1], 300, 6000);
  if CurrentFloor() = 1 then
  begin
    Logger.Info('Travel: on the middle floor - climbing down once more.');
    UseStaircase(Point(TOP_STAIRS.X - RSTranslator.MapWidth, TOP_STAIRS.Y), ['limb-down', 'limb-d', 'ottom']);
    SleepUntil(CurrentFloor() = 0, 300, 6000);
  end;
  Result := CurrentFloor() = 0;
end;


// ---------------------------------------------------------------- axes

// An axe our Woodcutting level can use in the inventory?
function CarriesUsableAxe(level: Integer): Boolean;
var
  i: Integer;
begin
  for i := 0 to High(AXES) do
    if ((level = 0) or (level >= AXE_LEVELS[i])) and (Inventory.Items.Count(AXES[i]) > 0) then
      Exit(True);
end;

// ...or worn?
function HasAxe(level: Integer): Boolean;
var
  i: Integer;
begin
  if CarriesUsableAxe(level) then
    Exit(True);
  if Equipment.Open() then
    for i := 0 to High(AXES) do
      if (Equipment.Items.Count(AXES[i]) > 0) and ((level = 0) or (level >= AXE_LEVELS[i])) then
      begin
        Inventory.Open();
        Exit(True);
      end;
  Inventory.Open();
end;

// ---------------------------------------------------------------- status updates

function Secs(ms: UInt64): String;
begin
  Result := ToStr(ms div 1000) + ' s';
end;

// ---------------------------------------------------------------- the woodcutter

type
  TCutter = record
    MaxTime: UInt64;
    Place: TCutPlace;
    Tree: Integer;                  // index into TREE_NAMES
    Mode: ELogMode;
    IgnoreChecks: Boolean;          // debug
    WCLevel, FMLevel: Integer;
    Trees: array of TTreeSpot;
    PlaceCenter: TPoint;            // map pixels
    BankObj: TObject;
    HasBankObj, HaveAxe: Boolean;
    Logs, Burnt, Trips, Failures: Integer;
    StartItems: TItemArray;         // what you started with: never banked or dropped
    FireTile: TPoint;               // the tile our fire is on (map pixels)...
    FireAt: UInt64;                 // ...and when it last had logs put on (0 = no fire)
    CampfireNearby: Boolean;        // the game said a Forester's Campfire is nearby
    StopReason: String;
    State: ECutState;
  end;

function TCutter.GetReportValues(): TStringArray;
var
  xp: UInt64;
begin
  xp := XPBar.TotalEarnedXP(False);
  Result := [
    Logger.TimeRunning.ElapsedFmt(TIME_SHORT),
    Self.Place.Name,
    TREE_NAMES[Self.Tree],
    ToStr(Self.Logs),
    FormatNumber(Self.Logs / Logger.TimeRunning.Elapsed * HOUR),
    FormatNumber(xp),
    FormatNumber(xp / Logger.TimeRunning.Elapsed * HOUR)
  ];
end;

// How long to keep chopping one tree with no new log. Low level for the tree = longer: you fail
// a lot, the tree is still there (the stump check moves on straight away if it's cut down).
function TCutter.Patience(): Integer;
var
  over: Integer;
begin
  Result := TREE_PATIENCE[Self.Tree];
  if (Self.Tree = 0) or (Self.WCLevel <= 0) then
    Exit;
  over := Self.WCLevel - TREE_WC_LEVELS[Self.Tree];
  if over < 10 then
    Result := Result * 3
  else if over < 20 then
    Result := Result * 2;
end;

function TCutter.LogName(): String;
begin
  Result := TREE_LOGS[Self.Tree];
end;

function TCutter.LogCount(): Integer;
begin
  Result := Inventory.Items.Count(Self.LogName());
end;

// What's never banked or dropped: the axes and the tinderbox
function TCutter.KeepItems(): TItemArray;
var
  a: String;
begin
  for a in AXES do
    Result += a;
  Result += 'Tinderbox';
  Result += Self.StartItems;
end;

// Near the trees (or upstairs at the Lumbridge bank)?
function TCutter.AtPlace(): Boolean;
begin
  if Self.Place.Lumbridge and (CurrentFloor() = 2) then
    Exit(True);
  Result := Map.Position().DistanceTo(Self.PlaceCenter) <= (Self.Place.Radius + 8) * RSTranslator.TILE_SIZE;
end;

// Every tree of the chosen kind WaspLib knows within the place's radius.
procedure TCutter.FindTrees();
var
  all: TMapObjectDataArray;
  single: TMapObjectData;
  name: String;
  i, j: Integer;
  t: TTreeSpot;
begin
  for name in TREE_OBJECTS[Self.Tree] do
  begin
    try
      all := MapObjects.GetByName(name);
    except
      Continue;
    end;
    for i := 0 to High(all) do
      for j := 0 to High(all[i].Coordinates) do
      begin
        if all[i].Coordinates[j].DistanceTo(Self.PlaceCenter) > Self.Place.Radius * RSTranslator.TILE_SIZE then
          Continue;
        single := all[i];
        single.Coordinates := [all[i].Coordinates[j]];
        if j <= High(all[i].Rotations) then
          single.Rotations := [all[i].Rotations[j]];
        t.Obj := TObject.Create(Map.Walker, single);
        t.Spot := all[i].Coordinates[j];
        t.FreeAt := 0;
        Self.Trees += t;
      end;
  end;
  Logger.Info('Trees: ' + ToStr(Length(Self.Trees)) + ' x ' + TREE_NAMES[Self.Tree] + ' at ' + Self.Place.Name + '.');
end;

// Everything in the inventory at the start (except logs) is yours to keep: never banked, never
// dropped, never burnt.
procedure TCutter.RememberStartItems();
var
  item, k: TItem;
  l: String;
  skip: Boolean;
begin
  Self.StartItems := [];
  for item in Inventory.Items.RecognizeAll() do
  begin
    if item = '' then
      Continue;
    skip := False;
    for l in TREE_LOGS do
      if SameText(item, l) then
        skip := True;
    for k in Self.StartItems do
      if SameText(item, k) then
        skip := True;
    if not skip then
      Self.StartItems += item;
  end;
  if Self.StartItems <> [] then
    Logger.Info('Keeping what you started with (never banked or dropped): ' + ToStr(Self.StartItems) + '.');
end;

procedure TCutter.Init();
var
  need: Integer;
begin
  Logger.Setup('DMB''s F2P Woodcutter');
  ProgressReport.Setup(
    'DMB''s F2P Woodcutter',
    ['Script runtime:', 'Place:', 'Tree:', 'Logs:', 'Logs/H:', 'Total XP:', 'XP/H:'],
    @Self.GetReportValues
  );

  if not Client.IsLoggedIn() then
    DoLoginSafe();
  StartListeners(300);
  if Options.SetNPCAttack('Hidden') or Options.SetNPCAttack(3) then
    Logger.Info('NPC attack option set to hidden.');

  Self.WCLevel := Stats.GetLevel(ESkill.WOODCUTTING, False);
  Self.FMLevel := Stats.GetLevel(ESkill.FIREMAKING, False);
  Inventory.Open();
  Logger.Info('Woodcutting level: ' + ToStr(Self.WCLevel) + ', Firemaking level: ' + ToStr(Self.FMLevel) + '.');
  Self.RememberStartItems();

  need := TREE_WC_LEVELS[Self.Tree];
  if (Self.WCLevel > 0) and (Self.WCLevel < need) then
  begin
    if not Self.IgnoreChecks then
      raise TREE_NAMES[Self.Tree] + ' needs ' + ToStr(need) + ' Woodcutting (you have ' + ToStr(Self.WCLevel) + ').';
    Logger.Warn('DEBUG: ' + TREE_NAMES[Self.Tree] + ' needs ' + ToStr(need) + ' Woodcutting - carrying on.');
  end;
  if Self.Mode = ELogMode.BURN then
  begin
    need := TREE_FM_LEVELS[Self.Tree];
    if (Self.FMLevel > 0) and (Self.FMLevel < need) then
    begin
      if not Self.IgnoreChecks then
        raise 'Burning ' + TREE_LOGS[Self.Tree] + ' needs ' + ToStr(need) + ' Firemaking (you have ' + ToStr(Self.FMLevel) + ').';
      Logger.Warn('DEBUG: burning ' + TREE_LOGS[Self.Tree] + ' needs ' + ToStr(need) + ' Firemaking - carrying on.');
    end;
  end;

  case Self.Mode of
    ELogMode.BANK: Logger.Info('Place: ' + Self.Place.Name + ', ' + TREE_NAMES[Self.Tree] + '. Banking at ' + Self.Place.BankName + '.');
    ELogMode.DROP: Logger.Info('Place: ' + Self.Place.Name + ', ' + TREE_NAMES[Self.Tree] + '. Dropping the logs.');
    ELogMode.BURN: Logger.Info('Place: ' + Self.Place.Name + ', ' + TREE_NAMES[Self.Tree] + '. Burning the logs.');
  end;

  Logger.Info('Map: loading the areas (this can take a moment the first time).');
  Map.Setup([Chunk(Box(45, 54, 53, 48), 0), Chunk(Box(50, 50, 50, 50), 2)]);
  Map.Walker.OnWalkEvent := @Map.Walker.Watchdog;
  Map.Walker.OnWaitMovingEvent := @Map.Walker.Watchdog;
  Map.Walker.ScreenWalk := False;

  if Self.Place.Local then
  begin
    // the trees within 15 tiles of where we stand now
    Self.PlaceCenter := Map.Position();
    Logger.Info('Local area: the trees within ' + ToStr(Self.Place.Radius) + ' tiles of where you stand, game (' +
                ToStr(Self.PlaceCenter.X div 4) + ', ' + ToStr((50430 - Self.PlaceCenter.Y) div 4) + ').');
    if Self.Mode = ELogMode.BANK then
      raise 'The local area has no bank - pick Cut and drop or Cut and burn.';
  end
  else
    Self.PlaceCenter := Tile(Self.Place.Center.X, Self.Place.Center.Y);
  Self.FindTrees();
  if Self.Trees = [] then
  begin
    if Self.Place.Local then
      raise 'WaspLib has no ' + TREE_NAMES[Self.Tree] + ' trees within ' + ToStr(Self.Place.Radius) +
            ' tiles of where you stand. Stand closer to them (or pick another tree) and start again.';
    raise 'WaspLib has no ' + TREE_NAMES[Self.Tree] + ' trees at ' + Self.Place.Name + '. Please post this log in a GitHub issue.';
  end;

  if (Self.Mode = ELogMode.BANK) and not Self.Place.Lumbridge then
  begin
    Self.HasBankObj := NearestObject(['Bank booth', 'Bank Booth', 'Bank chest'],
                                     Tile(Self.Place.Bank.X, Self.Place.Bank.Y), 12, Self.BankObj);
    if not Self.HasBankObj then
      Logger.Warn('Bank: no booth near ' + Self.Place.BankName + ' - will use WaspLib''s nearest bank.');
  end;

  Self.HaveAxe := HasAxe(Self.WCLevel);
  if Self.HaveAxe then
    Logger.Info('Axe: found.')
  else
    Logger.Info('Axe: none you can use in the inventory or worn - will take one out of the bank first.');
  if (Self.Mode = ELogMode.BURN) and (Inventory.Items.Count('Tinderbox') = 0) then
    Logger.Info('Tinderbox: none in the inventory - will take one out of the bank first.');

  Antiban.Zoom.Min := 15;
  Antiban.Zoom.Max := 40;
  Antiban.Skills := [ESkill.WOODCUTTING, ESkill.FIREMAKING, ESkill.TOTAL];
  SlowAntiban();
  Logger.Info('Start: we are at ' + Here() + '.');
end;

// ---------------------------------------------------------------- travel

procedure TCutter.Travel();
begin
  if (CurrentFloor() > 0) then
    if not LeaveTopFloor() then
    begin
      Inc(Self.Failures);
      if Self.Failures >= 4 then
        Self.StopReason := 'Could not get down the Lumbridge Castle stairs. Please post this log in a GitHub issue.';
      Exit;
    end;
  if Self.AtPlace() then
    Exit;

  Logger.Info('Travel: to ' + Self.Place.Name + ' (' +
              ToStr(Round(Map.Position().DistanceTo(Self.PlaceCenter) / RSTranslator.TILE_SIZE)) + ' tiles).');
  if SafeWebWalk(Self.PlaceCenter, 300000, Self.Place.Radius) or Self.AtPlace() then
  begin
    Logger.Info('Travel: at ' + Self.Place.Name + '.');
    Self.Failures := 0;
    Exit;
  end;
  Inc(Self.Failures);
  if Self.Failures >= 3 then
    Self.StopReason := 'Could not walk to ' + Self.Place.Name + ' (we are at ' + Here() + '). Please post this log in a GitHub issue.';
end;

// ---------------------------------------------------------------- bank

procedure TCutter.OpenBank();
var
  dest: TPoint;
  opened: Boolean;
begin
  if Self.Place.Lumbridge then
    opened := OpenLumbridgeBank()
  else
  begin
    dest := Tile(Self.Place.Bank.X, Self.Place.Bank.Y);
    if Map.Position().DistanceTo(dest) > 6 * RSTranslator.TILE_SIZE then
      SafeWebWalk(dest, 120000, 4);
    GuardWalk(45000);
    try
      if Self.HasBankObj then
        opened := Bank.Open(Self.BankObj, True)
      else
        opened := Bank.Open(True);
    except
      Logger.Warn('Bank: opening failed: ' + GetExceptionMessage());
    end;
    WalkDeadline := 0;
  end;

  if opened or Bank.IsOpen() then
    Exit;
  Inc(Self.Failures);
  Logger.Warn('Bank: could not open the bank (we are at ' + Here() + ').');
  if Self.Failures >= 4 then
    Self.StopReason := 'Could not open the ' + Self.Place.BankName + ' bank. Please post this log in a GitHub issue.';
end;

// The best axe the bank has that our level can use.
function TCutter.WithdrawAxe(): Boolean;
var
  i: Integer;
begin
  for i := 0 to High(BANK_AXES) do
  begin
    if (Self.WCLevel > 0) and (Self.WCLevel < BANK_AXE_LEVELS[i]) then
      Continue;
    Bank.Withdraw(new TBankItem(BANK_AXES[i], 1));
    if SleepUntil(Inventory.Items.Count(BANK_AXES[i]) > 0, 100, 2000) then
    begin
      Logger.Info('Bank: took out a ' + BANK_AXES[i] + '.');
      Exit(True);
    end;
  end;
end;

procedure TCutter.DoBank();
begin
  if Inventory.Items.ContainsDifferent(Self.KeepItems()) then
  begin
    Self.Logs += Self.LogCount();
    if Bank.DepositDifferent(Self.KeepItems()) then
      SleepUntil(not Inventory.Items.ContainsDifferent(Self.KeepItems()), 100, 3000);
    Inc(Self.Trips);
  end;

  if not Self.HaveAxe then
  begin
    Self.HaveAxe := CarriesUsableAxe(Self.WCLevel) or Self.WithdrawAxe();
    if not Self.HaveAxe then
    begin
      if not Self.IgnoreChecks then
      begin
        Self.StopReason := 'No axe a level ' + ToStr(Self.WCLevel) + ' woodcutter can use - not in the inventory, worn or in the bank.';
        Bank.Close();
        Exit;
      end;
      Logger.Warn('DEBUG: no axe - carrying on without one.');
      Self.HaveAxe := True;
    end;
  end;

  if (Self.Mode = ELogMode.BURN) and (Inventory.Items.Count('Tinderbox') = 0) then
  begin
    Bank.Withdraw(new TBankItem('Tinderbox', 1));
    if not SleepUntil(Inventory.Items.Count('Tinderbox') > 0, 100, 2000) then
    begin
      if not Self.IgnoreChecks then
      begin
        Self.StopReason := 'No tinderbox in the inventory or the bank (needed to burn the logs).';
        Bank.Close();
        Exit;
      end;
      Logger.Warn('DEBUG: no tinderbox - carrying on without one.');
    end
    else
      Logger.Info('Bank: took out a tinderbox.');
  end;

  Self.Failures := 0;
  Bank.Close();
  SleepUntil(not Bank.IsOpen(), 100, 3000);
end;

// ---------------------------------------------------------------- drop / burn

procedure TCutter.DoDrop();
begin
  Self.Logs += Self.LogCount();
  Logger.Info('Drop: dropping ' + ToStr(Self.LogCount()) + ' ' + Self.LogName() + '.');
  Inventory.ShiftDrop([Self.LogName()], Inventory.RandomPattern());
  if Self.LogCount() > 0 then
    Inventory.Drop([Self.LogName()]);
  Activity.Restart();
end;

// ---- burning: light one fire, then put all the logs on it
// Light a fire with the tinderbox, then select the logs in the inventory and click the fire:
// the game adds the logs to it one after another until they're all burnt. Fires aren't in
// WaspLib's map data, so the bot remembers the tile it lit the fire on and clicks exactly there
// (it hovers that tile and checks the hover text says Fire) - no searching the screen.

// Where a tile (map pixels) is on the game screen, from where we stand.
function TileOnScreen(tile: TPoint; out pt: TPoint): Boolean;
var
  mm: TPoint;
begin
  mm := TWalker.Point2MM(Map.Position(), tile, Minimap.CompassRadians);
  pt := Minimap.Vector2MSQuad([mm.X, mm.Y, 0], Minimap.CompassRadians).Bounds.Center;
  Result := MainScreen.Bounds.Contains(pt);
end;

// Our fire still going? Lit less than ~70 s ago (fed logs keep it going) and close by.
function TCutter.HaveFire(): Boolean;
begin
  Result := (Self.FireAt > 0) and (GetTimeRunning() - Self.FireAt < 70000) and
            (Map.Position().DistanceTo(Self.FireTile) <= 6 * RSTranslator.TILE_SIZE);
end;

// The newest chat line, lower case ('' if none).
function LastChatLine(): String;
begin
  try
    Result := Lowercase(Chat.GetMessage(High(Chat.MessageLines)));
  except
    Result := '';
  end;
end;

// "The fire catches and the logs begin to burn." (loose: the chat reader can garble a letter)
function FireCaughtMessage(line: String): Boolean;
begin
  Result := (Pos('fire catches', line) > 0) or (Pos('begin to burn', line) > 0) or
            (Pos('logs begin', line) > 0);
end;

// "There's a Forester's Campfire nearby, help tend to that one or move further away." - the
// game won't let us light a new fire next to one. (Matched loosely: the chat reader can garble
// a letter.)
function CampfireMessage(line: String): Boolean;
begin
  Result := (Pos('campfire nearby', line) > 0) or (Pos('tend to that one', line) > 0) or
            (Pos('move further away', line) > 0);
end;

// Is there a fire on `tile`? Hovers a few points of the tile and reads the hover text.
function FireOnTile(tile: TPoint): Boolean;
var
  pt, p: TPoint;
  k: Integer;
begin
  if not TileOnScreen(tile, pt) then
    Exit;
  for k := 0 to 4 do
  begin
    case k of
      0: p := pt;
      1: p := Point(pt.X, pt.Y - 10);
      2: p := Point(pt.X - 8, pt.Y - 5);
      3: p := Point(pt.X + 8, pt.Y - 5);
      4: p := Point(pt.X, pt.Y + 6);
    end;
    p := Point(p.X + Random(-2, 2), p.Y + Random(-2, 2));
    if not MainScreen.Bounds.Contains(p) then
      Continue;
    Mouse.Move(p);
    if MainScreen.IsUpText(['Fire', 'fire', 'Campfire'], True, 0.85, 60) then
      Exit(True);
  end;
end;

// Light a fire where we stand. "You can't light a fire here." -> step a few tiles and try
// again (up to 4 spots). True = lit; FireTile is where it burns.
function TCutter.LightFire(): Boolean;
var
  tries, before, cant, caught: Integer;
  spot: TPoint;
  lastLine: String;
  lit: Boolean;
begin
  for tries := 1 to 4 do
  begin
    Map.Walker.WaitMoving();
    spot := Map.Position();
    before := Self.LogCount();
    cant := Chat.CountNewMessage('You can''t light a fire here.');
    lastLine := LastChatLine();
    Self.CampfireNearby := False;
    caught := Chat.CountNewMessage('The fire catches and the logs begin to burn.');
    Inventory.Combine('Tinderbox', Self.LogName());
    Logger.Info('Burn: lighting a fire...');
    // The log leaves the inventory straight away (it's put on the ground) - that is NOT the
    // fire. Lit = the game says "The fire catches..." or we step off the spot (the player
    // always steps aside once the fire is going). Low Firemaking can take many tries: up to
    // 30 s. "You can't light a fire here." = move; a Forester's Campfire nearby = use that one.
    SleepUntil((Chat.CountNewMessage('The fire catches and the logs begin to burn.') > caught) or
               ((LastChatLine() <> lastLine) and FireCaughtMessage(LastChatLine())) or
               ((Self.LogCount() < before) and (Map.Position().DistanceTo(spot) >= RSTranslator.TILE_SIZE)) or
               (Chat.CountNewMessage('You can''t light a fire here.') > cant) or
               ((LastChatLine() <> lastLine) and CampfireMessage(LastChatLine())), 250, 30000);
    if (Self.LogCount() >= before) and CampfireMessage(LastChatLine()) and (LastChatLine() <> lastLine) then
    begin
      Logger.Info('Burn: the game says there''s a Forester''s Campfire nearby.');
      Self.CampfireNearby := True;
      Exit(False);
    end;
    lit := (Chat.CountNewMessage('The fire catches and the logs begin to burn.') > caught) or
           ((LastChatLine() <> lastLine) and FireCaughtMessage(LastChatLine())) or
           ((Self.LogCount() < before) and (Map.Position().DistanceTo(spot) >= RSTranslator.TILE_SIZE));
    if (not lit) and (Self.LogCount() < before) and
       (Chat.CountNewMessage('You can''t light a fire here.') <= cant) then
    begin
      // the log is on the ground but no fire yet after 30 s: still trying - give it 20 s more
      Logger.Info('Burn: still trying to light it...');
      lit := SleepUntil((Chat.CountNewMessage('The fire catches and the logs begin to burn.') > caught) or
                        ((LastChatLine() <> lastLine) and FireCaughtMessage(LastChatLine())) or
                        (Map.Position().DistanceTo(spot) >= RSTranslator.TILE_SIZE), 250, 20000);
      if not lit then
      begin
        Logger.Info('Burn: no fire after 50 s - picking a new spot.');
        StepDirection(Random(-1, 1), Random(-1, 1) or 1, Random(2, 4));
        Continue;
      end;
    end;
    if lit then
    begin
      Self.FireTile := spot;
      Self.FireAt := GetTimeRunning();
      Inc(Self.Burnt);
      Inc(Self.Logs);
      Logger.Info('Burn: fire lit.');
      // let the step aside finish and the fire settle before touching anything
      SleepUntil(not Minimap.IsPlayerMoving(), 150, 3000);
      Sleep(1500, 2200);
      // look at it: hover the fire's tile and read the hover text
      if FireOnTile(spot) then
        Logger.Info('Burn: fire checked - the hover text on its tile says Fire.')
      else
        Logger.Warn('Burn: no Fire hover text on its tile yet - will look again when adding the logs.');
      Exit(True);
    end;
    if Chat.CountNewMessage('You can''t light a fire here.') <= cant then
    begin
      Logger.Info('Burn: the fire didn''t catch in 30 s - trying again here.');
      Continue;
    end;
    Logger.Info('Burn: can''t light a fire here - moving a few tiles.');
    StepDirection(Random(-1, 1), Random(-1, 1) or 1, Random(2, 4));
  end;
end;

// Select the logs, then click our fire's tile once the hover text says Fire.
function TCutter.UseLogsOnFire(): Boolean;
var
  pt, p: TPoint;
  k, sel: Integer;
begin
  if not TileOnScreen(Self.FireTile, pt) then
  begin
    Logger.Warn('Burn: the fire isn''t on the screen.');
    Exit;
  end;
  if not Inventory.Select(Self.LogName(), True) then
    Exit;
  Sleep(300, 600);

  for k := 0 to 9 do
  begin
    if k = 5 then
      Sleep(800, 1200);             // not seen yet: give the fire a moment, then look again
    if (k = 5) and not TileOnScreen(Self.FireTile, pt) then
      Break;
    case k mod 5 of
      0: p := pt;
      1: p := Point(pt.X, pt.Y - 10);
      2: p := Point(pt.X - 8, pt.Y - 5);
      3: p := Point(pt.X + 8, pt.Y - 5);
      4: p := Point(pt.X, pt.Y + 6);
    end;
    p := Point(p.X + Random(-2, 2), p.Y + Random(-2, 2));
    if not MainScreen.Bounds.Contains(p) then
      Continue;
    Mouse.Move(p);
    if MainScreen.IsUpText(['Fire', 'fire', 'Campfire'], True, 0.85, 60) then
    begin
      Mouse.Click(EMouseButton.LEFT);
      Exit(True);
    end;
  end;

  // not found: unselect the logs again
  Logger.Warn('Burn: no fire at its tile (burnt out?).');
  sel := Inventory.GetSelected();
  if sel > -1 then
    Mouse.Click(Inventory.Slots.Box(sel), EMouseButton.LEFT);
end;

procedure TCutter.DoBurn();
var
  fails, before, last: Integer;
begin
  if Inventory.Items.Count('Tinderbox') = 0 then
  begin
    Logger.Warn('Burn: no tinderbox - to the bank for one.');
    Self.Mode := ELogMode.BANK;     // bank once for it, then back to burning
    Self.OpenBank();
    if Bank.IsOpen() then
      Self.DoBank();
    Self.Mode := ELogMode.BURN;
    Exit;
  end;

  fails := 0;
  while (Self.LogCount() > 0) and (fails < 5) and Client.IsLoggedIn() do
  begin
    // 1) a fire to put the logs on (ours, still going, close by) - or light one
    if not Self.HaveFire() then
      if not Self.LightFire() then
      begin
        Inc(fails);
        if Self.CampfireNearby then
        begin
          // our own fire turned into a Forester's Campfire when we fed it: tend that one
          if (Self.FireTile.X <> 0) and
             (Map.Position().DistanceTo(Self.FireTile) <= 10 * RSTranslator.TILE_SIZE) then
          begin
            Logger.Info('Burn: it''s our fire from before - putting the logs on that.');
            Self.FireAt := GetTimeRunning();
          end
          else
          begin
            // someone else's (or we don't know where it is): move further away and light there
            Logger.Info('Burn: not ours / not known - moving further away to light one.');
            StepDirection(Random(-1, 1), Random(-1, 1) or 1, Random(8, 11));
            Sleep(800, 1500);
            Continue;
          end;
        end
        else
        begin
          Sleep(800, 1500);
          Continue;
        end;
      end;
    if Self.LogCount() = 0 then
      Break;

    // 2) all the logs onto it
    before := Self.LogCount();
    if not (Self.UseLogsOnFire() and SleepUntil(Self.LogCount() < before, 200, 10000)) then
    begin
      Inc(fails);
      Self.FireAt := 0;             // assume it's gone: light a new one
      if Self.CampfireNearby then
        Self.FireTile := Point(0, 0); // ...and it wasn't where we thought: move away next time
      Sleep(800, 1500);
      Continue;
    end;
    Logger.Info('Burn: putting ' + ToStr(before) + ' ' + Self.LogName() + ' on the fire.');
    fails := 0;

    // they keep going on one after another while the logs keep going down
    repeat
      last := Self.LogCount();
      Self.FireAt := GetTimeRunning();
      Activity.Restart();
      if last = 0 then
        Break;
      if Chat.LeveledUp() then
      begin
        Chat.HandleLevelUp();
        Inventory.Open();
        Break;                      // the level-up stops it: put the rest on again
      end;
    until not SleepUntil(Self.LogCount() < last, 200, 9000);
    Logger.Info('Burn: ' + ToStr(before - Self.LogCount()) + ' logs burnt' +
                ', ' + ToStr(Self.LogCount()) + ' left.');
    Self.Burnt += before - Self.LogCount();
    Self.Logs += before - Self.LogCount();
  end;

  if Self.LogCount() > 0 then
  begin
    Logger.Warn('Burn: could not burn the rest - dropping them.');
    Self.DoDrop();
  end;
end;

// ---------------------------------------------------------------- cutting

// The nearest tree of our kind that isn't cut down (or -1).
function TCutter.PickTree(): Integer;
var
  me: TPoint;
  i: Integer;
  best, d: Double;
  now: UInt64;
begin
  Result := -1;
  me := Map.Position();
  now := GetTimeRunning();
  best := 1000000000;
  for i := 0 to High(Self.Trees) do
  begin
    if Self.Trees[i].FreeAt > now then
      Continue;
    d := Self.Trees[i].Spot.DistanceTo(me);
    if d < best then
    begin
      best := d;
      Result := i;
    end;
  end;
end;

procedure TCutter.DoCut();
var
  i, last, got, patience: Integer;
  hovered: Boolean;
  lastLogAt, deadline, nextLook, lastClickAt: UInt64;
begin
  i := Self.PickTree();
  if i = -1 then
  begin
    Logger.Info('Cut: every tree is cut down - waiting for one to grow back.');
    Sleep(1500, 2500);
    Exit;
  end;

  // hover it where it is; if it's not on the screen let WaspLib walk us closer - with our
  // time limit and 8 s stuck check (WaspLib's own walk has neither: a tree behind a fence
  // could keep it walking on the spot for ever)
  try
    hovered := Self.Trees[i].Obj.Hover(['Chop']);
    if not hovered then
    begin
      GuardWalk(25000);
      hovered := Self.Trees[i].Obj.WalkHover(['Chop']);
      WalkDeadline := 0;
    end;
  except
    WalkDeadline := 0;
    Logger.Warn('Cut: ' + GetExceptionMessage());
  end;
  if not hovered then
  begin
    // couldn't get to it (fenced off / behind a wall?): leave it alone for a minute
    Logger.Info('Cut: can''t get to that tree - trying another.');
    Self.Trees[i].FreeAt := GetTimeRunning() + 60000;
    Exit;
  end;

  // a cut-down tree is a stump: no "Chop down" in its hover text
  if not MainScreen.IsUpText(['Chop'], True, 0.85, 80) then
  begin
    Self.Trees[i].FreeAt := GetTimeRunning() + TREE_RESPAWN[Self.Tree] div 2;
    Exit;
  end;

  last := Self.LogCount();
  patience := Self.Patience();
  Mouse.Click(EMouseButton.LEFT);
  Logger.Info('Cut: chopping a ' + TREE_NAMES[Self.Tree] + ' ' +
              ToStr(Round(Self.Trees[i].Spot.DistanceTo(Map.Position()) / RSTranslator.TILE_SIZE)) +
              ' tiles away (patience ' + Secs(patience) + ', ' + ToStr(last) + ' logs in the inventory).');
  Map.Walker.WaitMoving();

  // keep chopping while the logs keep coming; every few seconds look at the tree again and
  // move on as soon as it's a stump; no log for `patience` -> another tree. While waiting,
  // click the tree again every 15-20 s in case the chopping stopped.
  lastLogAt := GetTimeRunning();
  lastClickAt := GetTimeRunning();
  nextLook := GetTimeRunning() + 3000;
  deadline := GetTimeRunning() + 600000;
  got := 0;
  repeat
    if Inventory.IsFull() then
    begin
      Logger.Info('Cut: inventory full (' + ToStr(got) + ' logs from this tree).');
      Break;
    end;
    if Self.LogCount() > last then
    begin
      got += Self.LogCount() - last;
      last := Self.LogCount();
      Logger.Info('Cut: got a log (' + ToStr(last) + ' in the inventory).');
      lastLogAt := GetTimeRunning();
      Activity.Restart();
    end;
    if GetTimeRunning() - lastLogAt > patience then
    begin
      Logger.Info('Cut: no log for ' + Secs(patience) + ' - trying another tree.');
      Self.Trees[i].FreeAt := GetTimeRunning() + 5000;
      Break;
    end;
    if (GetTimeRunning() > nextLook) and not Minimap.IsPlayerMoving() then
    begin
      nextLook := GetTimeRunning() + Random(2500, 4000);
      try
        Self.Trees[i].Obj.Hover([]);
      except
      end;
      if not MainScreen.IsUpText(['Chop'], True, 0.85, 60) then
      begin
        Logger.Info('Cut: the tree is cut down (' + ToStr(got) + ' logs from it) - next tree.');
        Self.Trees[i].FreeAt := GetTimeRunning() + TREE_RESPAWN[Self.Tree];
        Break;
      end;
      // still standing, no log for a while: click it again (the chopping may have stopped)
      if (GetTimeRunning() - Max(lastLogAt, lastClickAt) > Random(15000, 20000)) then
      begin
        Mouse.Click(EMouseButton.LEFT);
        lastClickAt := GetTimeRunning();
        Logger.Info('Cut: no log for ' + Secs(GetTimeRunning() - lastLogAt) + ' - clicking the tree again.');
      end;
    end;
    if Chat.LeveledUp() then
      Break;
    Sleep(200);
  until GetTimeRunning() > deadline;
end;

// ---------------------------------------------------------------- main loop

function ReallyInWilderness(): Boolean;
var
  i: Integer;
begin
  for i := 1 to 3 do
  begin
    if not InWilderness(Map.Position()) then
      Exit(False);
    if i < 3 then
      Sleep(700, 900);
  end;
  Result := True;
end;

function TCutter.GetState(): ECutState;
begin
  if WildernessHit or (InWilderness(Map.Position()) and ReallyInWilderness()) then
  begin
    if Self.StopReason = '' then
      Self.StopReason := 'Stopped at the Wilderness. Move the character out and restart.';
    Exit(ECutState.STOP);
  end;
  if Self.StopReason <> '' then
    Exit(ECutState.STOP);
  if Activity.IsFinished then
    Exit(ECutState.NO_ACTIVITY);
  if (Self.MaxTime > 0) and (Logger.TimeRunning.Elapsed >= Self.MaxTime) then
    Exit(ECutState.MAX_TIME);
  if not Client.IsLoggedIn() then
    Exit(ECutState.LOGIN);
  if Chat.LeveledUp() then
    Exit(ECutState.LEVEL_UP);
  if Bank.IsOpen() then
    Exit(ECutState.BANK);

  // no axe (or no tinderbox for burning): the bank first
  if not Self.HaveAxe then
    Exit(ECutState.OPEN_BANK);

  if Inventory.IsFull() then
    case Self.Mode of
      ELogMode.BANK: Exit(ECutState.OPEN_BANK);
      ELogMode.DROP: Exit(ECutState.DROP);
      ELogMode.BURN: Exit(ECutState.BURN);
    end;

  if not Self.AtPlace() or (CurrentFloor() > 0) then
    Exit(ECutState.TRAVEL);
  Result := ECutState.CUT;
end;

procedure TCutter.Run();
begin
  Self.Init();

  repeat
    CloseStrayInterface();
    UnselectItem();
    Self.State := Self.GetState();
    if Self.State <> ECutState.CUT then
      Logger.Info('State: ' + ToStr(Self.State));
    ProgressReport.Print();
    WaspClient.SubmitStats();

    case Self.State of
      ECutState.LOGIN: DoLoginSafe();
      ECutState.LEVEL_UP:
        begin
          Chat.HandleLevelUp();
          Self.WCLevel := Max(Self.WCLevel, Stats.GetLevel(ESkill.WOODCUTTING, False));
          Self.FMLevel := Max(Self.FMLevel, Stats.GetLevel(ESkill.FIREMAKING, False));
          Logger.Info('Level up! Woodcutting ' + ToStr(Self.WCLevel) + ', Firemaking ' + ToStr(Self.FMLevel) +
                      ' (patience now ' + Secs(Self.Patience()) + ').');
          Inventory.Open();
        end;
      ECutState.TRAVEL: Self.Travel();
      ECutState.OPEN_BANK: Self.OpenBank();
      ECutState.BANK: Self.DoBank();
      ECutState.DROP: Self.DoDrop();
      ECutState.BURN: Self.DoBurn();
      ECutState.CUT: Self.DoCut();
      ECutState.NO_ACTIVITY, ECutState.MAX_TIME, ECutState.STOP: Break;
    end;

    Antiban.DoAntiban();
  until False;

  if Self.StopReason <> '' then
    Logger.Error('Stopped: ' + Self.StopReason)
  else
    Logger.Info('Stopped: ' + ToStr(Self.State));
end;

// ---------------------------------------------------------------- settings window

var
  Cutter: TCutter;
  CutForm: TScriptForm;
  GuiWCLevel, GuiFMLevel: Integer;
  RuntimeEdit: TLazEdit;
  PlaceSelector, TreeSelector, ModeSelector: TLazComboBox;
  DebugBox: TLazCheckBox;
  StartLocked: String;

function TreeLockReason(tree: Integer; burn: Boolean): String;
begin
  if (GuiWCLevel > 0) and (GuiWCLevel < TREE_WC_LEVELS[tree]) then
    Result := 'needs ' + ToStr(TREE_WC_LEVELS[tree]) + ' Woodcutting (you have ' + ToStr(GuiWCLevel) + ')';
  if burn and (GuiFMLevel > 0) and (GuiFMLevel < TREE_FM_LEVELS[tree]) then
  begin
    if Result <> '' then
      Result += ', ';
    Result += 'burning needs ' + ToStr(TREE_FM_LEVELS[tree]) + ' Firemaking (you have ' + ToStr(GuiFMLevel) + ')';
  end;
end;

// The trees the chosen place has, with their levels; LOCKED ones marked.
// The places for the chosen mode: "Local area" (last) only with Cut and drop / Cut and burn.
procedure TScriptForm.OnModeChange(sender: TLazObject);
var
  i, keep: Integer;
begin
  keep := Max(0, PlaceSelector.ItemIndex);
  PlaceSelector.Items.Clear();
  for i := 0 to High(PLACES) do
  begin
    if PLACES[i].Local then
    begin
      if ModeSelector.ItemIndex <> 0 then
        PlaceSelector.Items.Add('Local area (the trees around where you stand)');
    end
    else
      PlaceSelector.Items.Add(PLACES[i].Name + ' (bank: ' + PLACES[i].BankName + ')');
  end;
  PlaceSelector.ItemIndex := Min(keep, PlaceSelector.Items.Count - 1);
  Self.OnPlaceChange(nil);
end;

procedure TScriptForm.OnPlaceChange(sender: TLazObject);
var
  p: TCutPlace;
  k: Integer;
  line: String;
begin
  p := PLACES[Max(0, PlaceSelector.ItemIndex)];
  TreeSelector.Items.Clear();
  for k := 0 to High(p.Trees) do
  begin
    line := TREE_NAMES[p.Trees[k]] + ' (Woodcutting ' + ToStr(TREE_WC_LEVELS[p.Trees[k]]) + ')';
    if TreeLockReason(p.Trees[k], ModeSelector.ItemIndex = 2) <> '' then
      line += ' - LOCKED';
    TreeSelector.Items.Add(line);
  end;
  TreeSelector.ItemIndex := High(p.Trees);     // the best tree there by default
end;

procedure TScriptForm.OnStart(sender: TLazObject); override;
var
  minutes: Integer;
  p: TCutPlace;
begin
  minutes := StrToInt(Trim(RuntimeEdit.Text), 60);
  if minutes < 1 then
    minutes := 60;
  Cutter.MaxTime := minutes * MINUTE;
  p := PLACES[Max(0, PlaceSelector.ItemIndex)];
  Cutter.Place := p;
  Cutter.Tree := p.Trees[Max(0, TreeSelector.ItemIndex)];
  Cutter.Mode := ELogMode(Max(0, ModeSelector.ItemIndex));
  Cutter.IgnoreChecks := DebugBox.Checked;
  if Cutter.IgnoreChecks then
    StartLocked := ''
  else
    StartLocked := TreeLockReason(Cutter.Tree, Cutter.Mode = ELogMode.BURN);
  inherited();
end;

procedure TScriptForm.Init();
var
  tab: TLazTabSheet;
  i: Integer;
begin
  if GuiWCLevel > 0 then
    Self.Setup('DMB''s F2P Woodcutter - Woodcutting ' + ToStr(GuiWCLevel) + ', Firemaking ' + ToStr(GuiFMLevel))
  else
    Self.Setup('DMB''s F2P Woodcutter');
  tab := Self.CreateTab('Woodcutter');

  RuntimeEdit := TLazEdit.CreateEx(tab, 'Runtime (minutes):', 'How long to run, in minutes.', 40, 40, 200);
  RuntimeEdit.Text := '60';

  ModeSelector := TLazComboBox.CreateEx(tab, 'Logs:', 'What to do with a full inventory of logs.', 40, 110, 300);
  ModeSelector.Items.Add('Cut and bank');
  ModeSelector.Items.Add('Cut and drop');
  ModeSelector.Items.Add('Cut and burn (tinderbox, Firemaking)');
  ModeSelector.ItemIndex := 0;

  PlaceSelector := TLazComboBox.CreateEx(tab, 'Place:', 'Where to cut. The bot walks there from wherever you are.', 40, 180, 380);

  TreeSelector := TLazComboBox.CreateEx(tab, 'Tree:', 'Which trees to cut (the Woodcutting level each needs).', 40, 250, 300);

  DebugBox := TLazCheckBox.CreateEx(tab, 'Debug: turn off the level and item checks',
    'For testing the walking only. LOCKED trees start anyway, and no axe / tinderbox only gives a warning.', 40, 320);

  PlaceSelector.OnChange := @Self.OnPlaceChange;
  ModeSelector.OnChange := @Self.OnModeChange;
  Self.OnModeChange(nil);

  Self.CreateAntibanTab();
  Self.CreateMiscTab();
  Self.Run();
end;

begin
  Logger.Info('*** Make sure your settings match the WaspLib suggested settings (Fixed - Classic layout, the right RuneLite profile). Wrong settings make the bot misread the screen. ***');
  SetupPlaces();

  Logger.Info('Reading your Woodcutting and Firemaking levels before opening the settings...');
  try
    if not Client.IsLoggedIn() then
      DoLoginSafe();
    GuiWCLevel := Stats.GetLevel(ESkill.WOODCUTTING, False);
    GuiFMLevel := Stats.GetLevel(ESkill.FIREMAKING, False);
    Inventory.Open();
  except
    Logger.Warn('Could not read the levels: ' + GetExceptionMessage());
  end;

  CutForm.Init();
  SetClientInputLocked(True);
  try
    if StartLocked <> '' then
      Logger.Error(TREE_NAMES[Cutter.Tree] + ' is locked: ' + StartLocked +
                   '. Pick another tree (or tick the debug box to run it anyway).')
    else
      Cutter.Run();
  finally
    SetClientInputLocked(False);
  end;
end.
