{$I WaspLib/main.simba}


// Log in, or back in after a disconnect, with WaspLib's own login: it clicks "Play" on the
// welcome screen (the Jagex launcher - no password needed), "Ok" after a disconnect and "Click
// here to play" in the lobby, and does nothing when we're already logged in. With no account
// saved in WaspLib it would stop the script ("No profiles declared"), so then it gets an empty
// one and only clicks through those screens.
var
  LoginFails: Integer;

function DoLoginSafe(): Boolean;
var
  p: TProfile;
begin
  if Client.IsLoggedIn() then
    Exit(True);
  try
    if Length(Profiles) > 0 then
      Result := Login.DoLogin()
    else
    begin
      p.Name := 'no password';
      p.Active := True;
      Result := Login.DoLogin(p);
    end;
  except
    Logger.Warn('Login: ' + GetExceptionMessage());
  end;
  Result := Result or Client.IsLoggedIn();
  if Result then
  begin
    LoginFails := 0;
    Logger.Info('Login: logged in.');
    Exit;
  end;
  Inc(LoginFails);
  Logger.Warn('Login: could not log in (try ' + ToStr(LoginFails) + ' of 5).');
  if LoginFails >= 5 then
    raise 'Could not log back in 5 times in a row. If the game asks for a password, save your account in WaspLib (or log in yourself and start the script again).';
  Sleep(5000, 10000);
end;

// =====================================================================================
//  DMB's F2P Smelter                                         Simba 2.0 + WaspLib
// =====================================================================================
// FILES (all in Scripts\)
//   dmb_f2p_smelter.simba     this script
//   Logs go to Data\Logs\DMB's F2P Smelter\
//
// HOW TO USE
//   Start it logged in (or at the login screen). It reads your Smithing level, then opens the
//   settings window. Pick the furnace and the bar, press Start. It walks to that furnace's bank
//   from anywhere in the F2P area, then: bank -> withdraw the ore -> furnace -> smelt -> bank.
//   While it runs, RuneLite ignores your own mouse and keyboard; they come back when it stops.
//   The ore (and coal / tin) must be in your bank.
//
// FURNACES                    BANK                          FROM BANK
//   Edgeville                 Edgeville                     14 tiles  (fastest)
//   Al Kharid                 Al Kharid                     30 tiles  (toll gate on the way in)
//   Falador                   Falador West                  40 tiles  (your recorded route)
//   Lumbridge                 Lumbridge Castle, top floor   85 tiles  (up and down the stairs)
//   (the Wilderness furnace is left out on purpose)
//
// BARS                 ORE PER BAR                SMITHING   PER TRIP (28 free slots)
//   Bronze             1 copper + 1 tin           1          14
//   Iron               1 iron ore                 15         28 (only ~half succeed: F2P has no
//                                                                ring of forging)
//   Silver             1 silver ore               20         28
//   Steel              1 iron ore + 2 coal        30         9
//   Gold               1 gold ore                 40         28
//   Mithril            1 mithril ore + 4 coal     50         5
//   Adamantite         1 adamantite ore + 6 coal  70         4
//   Runite             1 runite ore + 8 coal      85         3
//   Bars you lack the Smithing level for say LOCKED in the settings and won't start.
//
// DEBUG (tick "Debug: turn off the Smithing level check") - for testing the walking:
//   - a LOCKED bar starts anyway (the game won't smelt it: it goes back to the bank and round)
//   - no ore in the bank doesn't stop it: it still walks to the furnace, clicks it, and goes
//     back to the bank, round and round. Look for DEBUG lines in the log.
//
// AL KHARID TOLL GATE (no settings: it tries the gate and sees what happens)
//   1. "Open" - free with Prince Ali Rescue. 2. A guard asking for money: pays with 10+ coins
//   in the inventory. 3. "Pay-toll" with 10+ coins. 4. Not through: it assumes it can't get
//   through and walks the long way round the fence. Once in Al Kharid it never leaves.
//
// SAFETY
//   - never walks into the Wilderness (Edgeville is close to it)
//   - every walk has a time limit and stops when we haven't moved for 8 s
//   - stops with the reason in the log when the bank runs out of ore, or when it can't get
//     somewhere after a few tries
// =====================================================================================

type
  EBar = enum(BRONZE, IRON, SILVER, STEEL, GOLD, MITHRIL, ADAMANT, RUNE);

  TFurnaceSite = record
    Name, BankName: String;
    Furnace, Bank: TPoint;          // game tiles: the furnace and where to stand at the bank
    Lumbridge: Boolean;             // the bank is upstairs in the castle
    AlKharid: Boolean;              // behind the toll gate
  end;

  ESmelterState = enum(LOGIN, LEVEL_UP, TRAVEL, OPEN_BANK, BANK, OPEN_FURNACE, SELECT_BAR,
                       WAIT_SMELT, OUT_OF_SUPPLIES, NO_ACTIVITY, MAX_TIME, STOP);

const
  ANTIBAN_SLOWDOWN = 3;
  TOLL_COINS = 10;

var
  SITES: array of TFurnaceSite;

  BAR_NAMES: TStringArray = ['Bronze bar', 'Iron bar', 'Silver bar', 'Steel bar', 'Gold bar',
                             'Mithril bar', 'Adamantite bar', 'Runite bar'];
  BAR_LEVELS: TIntegerArray = [1, 15, 20, 30, 40, 50, 70, 85];
  BAR_ORE1: TStringArray = ['Copper ore', 'Iron ore', 'Silver ore', 'Iron ore', 'Gold ore',
                        'Mithril ore', 'Adamantite ore', 'Runite ore'];
  BAR_ORE2: TStringArray = ['Tin ore', '', '', 'Coal', '', 'Coal', 'Coal', 'Coal'];
  ORE2_PER_BAR: TIntegerArray = [1, 0, 0, 2, 0, 4, 6, 8];

  // Lumbridge Castle (tested in the miner and fisher): ground-floor staircase, top floor
  LUMBRIDGE_STAIRS: TPoint = [12824, 37594];   // game (3206, 3209)
  TOP_STAIRS: TPoint = [64032, 37590];
  TOP_BANK: TPoint = [64036, 37550];

  // Falador: your recorded walk between the west bank and the furnace (coordinate finder)
  FALADOR_ROUTE: TPointArray = [
    [11788, 36958], [11784, 36938], [11804, 36926], [11836, 36914],
    [11872, 36914], [11892, 36938], [11900, 36954]
  ];

  // Lumbridge <-> Al Kharid toll gate (from the miner)
  TOLL_GATE: TPoint = [13068, 37522];
  GATE_WEST: TPoint = [13060, 37522];   // game (3265, 3227)
  GATE_EAST: TPoint = [13076, 37522];   // game (3269, 3227)
  // the long way round the fence (no coins, no Prince Ali Rescue), game tiles
  LONG_WAY: TPointArray = [
    [3265, 3227], [3260, 3236], [3259, 3246], [3252, 3254], [3251, 3264], [3246, 3273],
    [3240, 3281], [3239, 3291], [3239, 3301], [3245, 3311], [3251, 3319], [3261, 3322],
    [3269, 3329], [3279, 3330], [3275, 3319], [3275, 3309], [3275, 3299], [3269, 3291],
    [3269, 3281], [3269, 3271], [3269, 3261], [3269, 3251], [3269, 3241], [3269, 3231],
    [3269, 3227]
  ];

  // walker watchdog
  WalkDeadline, WalkLogAt, WalkStallSince: UInt64;
  WalkStallSpot: TPoint;
  WildernessHit: Boolean;

procedure AddSite(name, bankName: String; fx, fy, bx, by: Integer; lumbridge, alKharid: Boolean);
var
  s: TFurnaceSite;
begin
  s.Name := name;
  s.BankName := bankName;
  s.Furnace := Point(fx, fy);
  s.Bank := Point(bx, by);
  s.Lumbridge := lumbridge;
  s.AlKharid := alKharid;
  SITES += s;
end;

// Furnace and bank tiles are close enough for WaspLib to find the real furnace / booth nearby.
procedure SetupSites();
begin
  AddSite('Edgeville', 'Edgeville',                3109, 3499, 3094, 3492, False, False);
  AddSite('Al Kharid', 'Al Kharid',                3275, 3186, 3270, 3167, False, True);
  AddSite('Falador', 'Falador West',               2975, 3369, 2947, 3368, False, False);
  AddSite('Lumbridge', 'Lumbridge Castle (top floor)', 3226, 3254, 3206, 3209, True, False);
end;

// ---------------------------------------------------------------- helpers (from the miner/fisher)

// Game tile -> WaspLib map pixels (the same numbers the coordinate finder shows)
function Tile(x, y: Integer): TPoint;
begin
  Result := Point(x * 4, 50430 - y * 4);
end;

// North of the Wilderness ditch (game y 3523 and up)? Map pixels.
function InWilderness(p: TPoint): Boolean;
var
  gx, gy: Integer;
begin
  if (p.X = 0) and (p.Y = 0) then
    Exit(False);
  gx := p.X div 4;
  gy := (50430 - p.Y) div 4;
  Result := (gx >= 2940) and (gx <= 3400) and (gy >= 3523) and (gy <= 3970);
end;

// East of the Lumbridge / Al Kharid fence?
function InAlKharid(p: TPoint): Boolean;
var
  gx, gy: Integer;
begin
  if (p.X = 0) and (p.Y = 0) then
    Exit(False);
  gx := p.X div 4;
  gy := (50430 - p.Y) div 4;
  Result := (gx >= 3268) and (gy >= 3130) and (gy <= 3330);
end;

// A window popped up that the script didn't open (a misclick on a poll booth, a notice board...):
// close it with its X and carry on. The bank, deposit box, anvil and jewellery screens are left
// alone. Uses WaspLib's general main-screen window check (MSInterface).
var
  StrayCheckAt: UInt64;

function CloseStrayInterface(force: Boolean = False): Boolean;
var
  x: TBox;
begin
  if (not force) and (GetTimeRunning() < StrayCheckAt) then
    Exit;
  StrayCheckAt := GetTimeRunning() + 1500;
  try
    if Bank.IsOpen() or DepositBox.IsOpen() or Anvil.IsOpen() or GoldScreen.IsOpen() or SilverScreen.IsOpen() then
      Exit;
    if not MSInterface.IsOpen() then
      Exit;
    x := MSInterface.GetCloseButton();
    if x = Default(TBox) then
      Exit;
    Logger.Warn('A window popped up (a misclick on a poll booth or similar) - closing it.');
    Mouse.Click(x, EMouseButton.LEFT);
    Result := SleepUntil(not MSInterface.IsOpen(), 100, 1500);
  except
  end;
end;

// An item left selected in the inventory (e.g. after a misclick) makes every click on the
// game "Use item ->", and the bank / objects can't be opened. Unselect it.
procedure UnselectItem();
var
  sel: Integer;
begin
  try
    sel := Inventory.GetSelected();
  except
    Exit;
  end;
  if sel < 0 then
    Exit;
  Logger.Info('An item in the inventory was selected (slot ' + ToStr(sel + 1) + ') - unselecting it.');
  Mouse.Click(Inventory.Slots.Box(sel), EMouseButton.LEFT);
  SleepUntil(Inventory.GetSelected() < 0, 100, 1500);
  Mouse.Move(Point(MainScreen.Bounds.Center.X + Random(-80, 80), MainScreen.Bounds.Center.Y + Random(-60, 60)));
end;


// Is this walk hopeless? Logged out (the walker would keep "walking" on the login screen), or
// our position jumping tens of tiles back and forth (a bad reading, e.g. while logged out or
// on a loading screen). Then the walk is stopped and the main loop logs back in / retries.
var
  SaneCheckAt: UInt64;
  LastSanePos: TPoint;
  PosJumps: Integer;

function WalkLooksWrong(position: TPoint): Boolean;
begin
  if GetTimeRunning() >= SaneCheckAt then
  begin
    SaneCheckAt := GetTimeRunning() + 2000;
    if not Client.IsLoggedIn() then
    begin
      Logger.Warn('Walk: we are logged out - stopping the walk (the script logs back in).');
      LastSanePos := Point(0, 0);
      Exit(True);
    end;
  end;

  if (position.X = 0) and (position.Y = 0) then
    Exit;
  if (LastSanePos.X <> 0) and (position.DistanceTo(LastSanePos) > 25 * RSTranslator.TILE_SIZE) then
  begin
    Inc(PosJumps);
    if PosJumps >= 4 then
    begin
      Logger.Warn('Walk: our position keeps jumping around (now [' + ToStr(position.X) + ', ' +
                  ToStr(position.Y) + ']) - the reading is off, stopping this walk.');
      PosJumps := 0;
      LastSanePos := Point(0, 0);
      Exit(True);
    end;
  end
  else
    PosJumps := 0;
  LastSanePos := position;
end;

procedure TWalker.Watchdog(walker: PRSWalker; position, destination: TPoint);
begin
  CloseStrayInterface();
  if WalkLooksWrong(position) then
  begin
    walker^.Walking := False;
    WalkDeadline := 0;
    Exit;
  end;
  // never into the Wilderness (a destination hundreds of tiles away is a bad point from
  // WaspLib's walker, not a real walk - only trust destinations near us)
  if InWilderness(position) or
     (InWilderness(destination) and (position.DistanceTo(destination) <= 150 * RSTranslator.TILE_SIZE)) then
  begin
    Logger.Error('Walk: this walk goes into the Wilderness - stopping it (at [' + ToStr(position.X) + ', ' +
                 ToStr(position.Y) + '], heading to [' + ToStr(destination.X) + ', ' + ToStr(destination.Y) + ']).');
    WildernessHit := True;
    walker^.Walking := False;
    WalkDeadline := 0;
    Exit;
  end;

  if GetTimeRunning() > WalkLogAt then
  begin
    WalkLogAt := GetTimeRunning() + 3000;
    Logger.Info('Walking: at [' + ToStr(position.X) + ', ' + ToStr(position.Y) + '], next point ' +
                ToStr(Round(position.DistanceTo(destination) / RSTranslator.TILE_SIZE)) + ' tiles away.');
  end;

  if (WalkDeadline > 0) and (GetTimeRunning() > WalkDeadline) then
  begin
    Logger.Warn('Walk: took too long, stopping it.');
    walker^.Walking := False;
    WalkDeadline := 0;
    Exit;
  end;

  // stuck against something: not moved a tile in 8 s -> stop
  if WalkDeadline > 0 then
  begin
    if position.DistanceTo(WalkStallSpot) >= RSTranslator.TILE_SIZE then
    begin
      WalkStallSpot := position;
      WalkStallSince := GetTimeRunning();
    end
    else if GetTimeRunning() - WalkStallSince > 8000 then
    begin
      Logger.Warn('Walk: not moved for 8 s at [' + ToStr(position.X) + ', ' + ToStr(position.Y) +
                  '] (stuck on something), stopping this walk.');
      walker^.Walking := False;
      WalkDeadline := 0;
    end;
  end;
end;

// Start the watchdog's time limit + stall check for a walk WaspLib does itself (bank, furnace).
procedure GuardWalk(ms: Integer);
begin
  WalkStallSpot := Map.Position();
  WalkStallSince := GetTimeRunning();
  WalkDeadline := GetTimeRunning() + ms;
end;

// WaspLib's walker with a time limit. True when we end within `reachTiles` of `dest`.
// WaspLib's walker can't plan a route from some spots inside buildings (e.g. at the Al Kharid
// furnace: "no nodes near ... on the same cluster"). Then click the minimap a few tiles toward
// where we're going - the game finds its own way out - and let WaspLib try again from there.
var
  LastWalkError: String;

function StepToward(dest: TPoint; tiles: Integer): Boolean;
var
  me, pt, mm: TPoint;
  d: Double;
begin
  me := Map.Position();
  d := me.DistanceTo(dest);
  if d < 2 * RSTranslator.TILE_SIZE then
    Exit;
  if d > tiles * RSTranslator.TILE_SIZE then
    pt := Point(me.X + Round((dest.X - me.X) * tiles * RSTranslator.TILE_SIZE / d),
                me.Y + Round((dest.Y - me.Y) * tiles * RSTranslator.TILE_SIZE / d))
  else
    pt := dest;
  Logger.Info('Walk: WaspLib can''t plan a route from this spot - stepping ' + ToStr(tiles) + ' tiles toward it first.');
  mm := TWalker.Point2MM(me, pt, Minimap.CompassRadians);
  Mouse.Click(Point(mm.X + Random(-2, 2), mm.Y + Random(-2, 2)), EMouseButton.LEFT);
  Sleep(800, 1200);
  SleepUntil(not Minimap.IsPlayerMoving(), 150, 10000);
  Result := Map.Position().DistanceTo(me) > 2 * RSTranslator.TILE_SIZE;
end;

function SafeWebWalkOnce(dest: TPoint; ms, reachTiles: Integer): Boolean;
var
  path, dense: TPointArray;
  i, k, steps: Integer;
begin
  CloseStrayInterface(True);   // a window left open (misclick) blocks the walk
  if InWilderness(dest) then
  begin
    Logger.Error('Walk: refusing to walk into the Wilderness.');
    WildernessHit := True;
    Exit(False);
  end;

  GuardWalk(ms);
  try
    // fill in a point every 10 tiles: the minimap only reaches ~15 tiles
    path := Map.Walker.GetPath(Map.Position(), dest, 0.3);
    for i := 0 to High(path) do
    begin
      if i > 0 then
      begin
        steps := Ceil(path[i - 1].DistanceTo(path[i]) / (10 * RSTranslator.TILE_SIZE));
        for k := 1 to steps - 1 do
          dense += Point(path[i - 1].X + (path[i].X - path[i - 1].X) * k div steps,
                         path[i - 1].Y + (path[i].Y - path[i - 1].Y) * k div steps);
      end;
      dense += path[i];
    end;
    if dense <> [] then
      Map.Walker.WalkPath(dense, 8)
    else
      Map.Walker.WebWalk(dest, 8, 0.3);
  except
    LastWalkError := GetExceptionMessage();
    Logger.Warn('Walk: WaspLib''s walker failed: ' + LastWalkError);
  end;
  WalkDeadline := 0;
  Result := Map.Position().DistanceTo(dest) <= reachTiles * RSTranslator.TILE_SIZE;
end;

function SafeWebWalk(dest: TPoint; ms, reachTiles: Integer): Boolean;
begin
  LastWalkError := '';
  Result := SafeWebWalkOnce(dest, ms, reachTiles);
  if (not Result) and (Pos('no nodes near', LastWalkError) > 0) and StepToward(dest, 10) then
    Result := SafeWebWalkOnce(dest, ms, reachTiles);
end;

// Minimap click `tiles` tiles away in a world direction (dx east, dy north = -1...).
procedure StepDirection(dx, dy, tiles: Integer);
var
  base, mm: TPoint;
begin
  base := Point(20000, 20000);
  mm := TWalker.Point2MM(base, Point(base.X + dx * tiles * 4, base.Y + dy * tiles * 4), Minimap.CompassRadians);
  Mouse.Click(Point(mm.X + Random(-2, 2), mm.Y + Random(-2, 2)), EMouseButton.LEFT);
  Sleep(600, 900);
  SleepUntil(not Minimap.IsPlayerMoving(), 150, 8000);
end;

// The object called one of `names` that WaspLib knows closest to `spot` (within maxTiles).
function NearestObject(names: TStringArray; spot: TPoint; maxTiles: Integer; out obj: TObject): Boolean;
var
  all: TMapObjectDataArray;
  single: TMapObjectData;
  name: String;
  i, j, bj: Integer;
  best, d: Double;
begin
  best := 1000000000;
  bj := -1;
  for name in names do
  begin
    try
      all := MapObjects.GetByName(name);
    except
      Logger.Warn('WaspLib objects: looking up "' + name + '" failed: ' + GetExceptionMessage());
      Continue;
    end;
    for i := 0 to High(all) do
      for j := 0 to High(all[i].Coordinates) do
      begin
        d := all[i].Coordinates[j].DistanceTo(spot);
        if d < best then
        begin
          best := d;
          single := all[i];
          bj := j;
        end;
      end;
  end;

  if bj = -1 then
  begin
    Logger.Warn('WaspLib objects: no "' + names[0] + '" in the loaded map at all.');
    Exit(False);
  end;
  if best > maxTiles * RSTranslator.TILE_SIZE then
  begin
    Logger.Warn('WaspLib objects: nearest "' + single.Name + '" is ' + ToStr(Round(best / RSTranslator.TILE_SIZE)) +
                ' tiles away (want ' + ToStr(maxTiles) + ').');
    Exit(False);
  end;

  single.Coordinates := [single.Coordinates[bj]];
  if bj <= High(single.Rotations) then
    single.Rotations := [single.Rotations[bj]];
  obj := TObject.Create(Map.Walker, single);
  Result := True;
end;

procedure CancelMenu();
begin
  if not ChooseOption.IsOpen() then
    Exit;
  if not ChooseOption.Select(['Cancel', 'ancel']) then
    ChooseOption.Close();
  Sleep(80, 200);
end;

// Use the staircase WaspLib knows next to `spot`. `wanted` are bits of the menu line to pick,
// best first (the menu reader garbles letters, so short bits: 'op-floor', 'limb-up'...). The
// first menu line containing the earliest bit wins. The log says which line it clicked.
function UseStaircase(spot: TPoint; wanted: TStringArray): Boolean;
var
  stairs: TObject;
  opt, pick: TOption;
  menu, w: String;
  hovered, found: Boolean;
begin
  if NearestObject(['Staircase'], spot, 6, stairs) then
    try
      hovered := stairs.Hover([]);
      if not hovered then
        hovered := stairs.WalkHover([]);
    except
      Logger.Warn('Stairs: ' + GetExceptionMessage());
    end
  else
    Logger.Warn('Stairs: WaspLib knows no staircase here.');

  if not hovered then
  begin
    Logger.Warn('Stairs: could not hover the staircase.');
    Exit;
  end;

  Mouse.Click(EMouseButton.RIGHT);
  if not SleepUntil(ChooseOption.IsOpen(), 50, 1500) then
  begin
    Logger.Warn('Stairs: the right-click menu did not open.');
    Exit;
  end;
  Sleep(150, 350);

  for opt in ChooseOption.GetOptions() do
    menu += '[' + opt.Text + '] ';
  found := False;
  for w in wanted do
  begin
    for opt in ChooseOption.GetOptions() do
      if Pos(Lowercase(w), Lowercase(opt.Text)) > 0 then
      begin
        pick := opt;
        found := True;
        Break;
      end;
    if found then
      Break;
  end;

  if not found then
  begin
    Logger.Warn('Stairs: none of ' + ToStr(wanted) + ' in the menu. It says: ' + menu);
    CancelMenu();
    Exit;
  end;
  Logger.Info('Stairs: clicking "' + pick.Text + '" (menu: ' + menu + ').');
  ChooseOption.Select(pick);
  Sleep(2500, 3500);
  Result := True;
end;

// Which floor are we on? Upper floors sit to the right on WaspLib's map.
function CurrentFloor(): Integer;
var
  me: TPoint;
begin
  me := Map.Position();
  if (me.X = 0) and (me.Y = 0) then
    Exit(-1);
  Result := me.X div RSTranslator.MapWidth;
end;

function Here(): String;
var
  me: TPoint;
begin
  me := Map.Position();
  Result := '[' + ToStr(me.X) + ', ' + ToStr(me.Y) + ']';
end;

procedure SlowAntiban();
var
  i: Integer;
begin
  for i := 0 to High(Antiban.Tasks) do
  begin
    Antiban.Tasks[i].Interval := Antiban.Tasks[i].Interval * ANTIBAN_SLOWDOWN;
    Antiban.Tasks[i].Countdown.Start(Round(Antiban.Tasks[i].Interval * Random(60, 100) / 100));
  end;
  for i := 0 to High(Antiban.WalkTasks) do
  begin
    Antiban.WalkTasks[i].Interval := Antiban.WalkTasks[i].Interval * ANTIBAN_SLOWDOWN;
    Antiban.WalkTasks[i].Countdown.Start(Round(Antiban.WalkTasks[i].Interval * Random(60, 100) / 100));
  end;
end;

procedure SetClientInputLocked(locked: Boolean);
begin
  if RemoteInput.Target = nil then
    Exit;
  EIOS_SetMouseInputEnabled(RemoteInput.Target, not locked);
  EIOS_SetKeyboardInputEnabled(RemoteInput.Target, not locked);
  if locked then
    Logger.Info('Client locked: your real mouse and keyboard are ignored by RuneLite.')
  else
    Logger.Info('Client unlocked.');
end;

// Coins in the inventory: the size of the stack (Count would only count the slots).
function CoinCount(): Integer;
var
  i: Integer;
begin
  for i := 1 to 3 do
  begin
    Result := Max(Result, Inventory.Items.CountEx('Coins'));
    if Result >= TOLL_COINS then
      Break;
    Sleep(300, 500);
  end;
end;

// ---------------------------------------------------------------- Lumbridge Castle bank

function OpenLumbridgeBank(): Boolean;
var
  booth: TObject;
begin
  if CurrentFloor() <> 2 then
  begin
    Logger.Info('Bank: to the Lumbridge Castle staircase.');
    if not SafeWebWalk(LUMBRIDGE_STAIRS, 180000, 3) then
    begin
      Logger.Warn('Bank: did not reach the staircase (we are at ' + Here() + ').');
      Exit;
    end;
    Map.Walker.WaitMoving();
    Logger.Info('Bank: climbing to the top floor.');
    if not UseStaircase(LUMBRIDGE_STAIRS, ['op-floor', 'top floor', 'floor', 'limb-up', 'limb-u']) then
      Exit;
    SleepUntil(CurrentFloor() in [1, 2], 300, 6000);
    if CurrentFloor() = 1 then
    begin
      Logger.Info('Bank: on the middle floor - climbing up once more.');
      UseStaircase(Point(LUMBRIDGE_STAIRS.X + RSTranslator.MapWidth, LUMBRIDGE_STAIRS.Y), ['limb-up', 'limb-u', 'op-floor']);
      SleepUntil(CurrentFloor() = 2, 300, 6000);
    end;
    if CurrentFloor() <> 2 then
    begin
      Logger.Warn('Bank: not on the top floor after climbing (we are at ' + Here() + ', floor ' + ToStr(CurrentFloor()) + ').');
      Exit;
    end;
  end;

  Logger.Info('Bank: opening the top-floor bank booth.');
  if not NearestObject(['Bank booth', 'Bank Booth'], TOP_BANK, 8, booth) then
    Exit;
  GuardWalk(45000);
  try
    Result := Bank.Open(booth, True);
  except
    Logger.Warn('Bank: ' + GetExceptionMessage());
  end;
  WalkDeadline := 0;
end;

function LeaveTopFloor(): Boolean;
begin
  Logger.Info('Travel: down the Lumbridge Castle stairs.');
  if not SafeWebWalk(TOP_STAIRS, 30000, 2) then
    StepDirection(0, 1, 9);
  if UseStaircase(TOP_STAIRS, ['ottom-floor', 'ottom', 'floor', 'limb-down', 'limb-d']) then
    SleepUntil(CurrentFloor() in [0, 1], 300, 6000);
  if CurrentFloor() = 1 then
  begin
    Logger.Info('Travel: on the middle floor - climbing down once more.');
    UseStaircase(Point(TOP_STAIRS.X - RSTranslator.MapWidth, TOP_STAIRS.Y), ['limb-down', 'limb-d', 'ottom']);
    SleepUntil(CurrentFloor() = 0, 300, 6000);
  end;
  Result := CurrentFloor() = 0;
end;

// ---------------------------------------------------------------- Falador route

// Your recorded walk between Falador West bank and the furnace, point by point with WaspLib's
// walker (each point is close, so these are short walks). Starts at the point nearest to us.
function WalkFalador(toBank: Boolean): Boolean;
var
  path: TPointArray;
  i, start: Integer;
  best: Double;
  me: TPoint;
begin
  // (written out plainly, like the long way round: "if ... for ... else" can go wrong)
  SetLength(path, Length(FALADOR_ROUTE));
  for i := 0 to High(FALADOR_ROUTE) do
    if toBank then
      path[i] := FALADOR_ROUTE[High(FALADOR_ROUTE) - i]
    else
      path[i] := FALADOR_ROUTE[i];

  me := Map.Position();
  best := 1000000000;
  for i := 0 to High(path) do
    if me.DistanceTo(path[i]) < best then
    begin
      best := me.DistanceTo(path[i]);
      start := i;
    end;
  if best > 20 * RSTranslator.TILE_SIZE then
    Exit(False);                                  // not near the route: walk normally instead

  for i := start to High(path) do
    if not SafeWebWalk(path[i], 25000, 2) then
    begin
      Logger.Warn('Falador route: stuck at point ' + ToStr(i + 1) + '/' + ToStr(Length(path)) + ' (we are at ' + Here() + ').');
      Exit(False);
    end;
  Result := True;
end;

// ---------------------------------------------------------------- the smelter

type
  TSmelter = record
    MaxTime: UInt64;
    Site: TFurnaceSite;
    Bar: EBar;
    FreeGate: Boolean;              // the toll gate let us through for free (Prince Ali Rescue)
    IgnoreLevels: Boolean;          // debug: run even when the Smithing level is too low
    SmithingLevel: Integer;
    FurnaceObj, BankObj: TObject;
    HasBankObj: Boolean;
    Smelting: Boolean;
    DebugToFurnace: Boolean;        // debug: go to the furnace even without ore
    DebugToBank: Boolean;           // debug: the furnace visit is done, back to the bank
    Bars, Trips, Failures: Integer;
    StopReason: String;
    State: ESmelterState;
  end;

function TSmelter.GetReportValues(): TStringArray;
var
  xp: UInt64;
begin
  xp := XPBar.TotalEarnedXP(False);
  Result := [
    Logger.TimeRunning.ElapsedFmt(TIME_SHORT),
    Self.Site.Name,
    BAR_NAMES[Ord(Self.Bar)],
    ToStr(Self.Bars),
    FormatNumber(Self.Bars / Logger.TimeRunning.Elapsed * HOUR),
    FormatNumber(xp),
    FormatNumber(xp / Logger.TimeRunning.Elapsed * HOUR)
  ];
end;

function TSmelter.Ore1(): String;
begin
  Result := BAR_ORE1[Ord(Self.Bar)];
end;

function TSmelter.Ore2(): String;
begin
  Result := BAR_ORE2[Ord(Self.Bar)];
end;

function TSmelter.Per2(): Integer;
begin
  Result := ORE2_PER_BAR[Ord(Self.Bar)];
end;

// Enough in the inventory for at least one more bar?
function TSmelter.HasMaterials(): Boolean;
begin
  Result := Inventory.Items.Count(Self.Ore1()) > 0;
  if Result and (Self.Per2() > 0) then
    Result := Inventory.Items.Count(Self.Ore2()) >= Self.Per2();
end;

// Near the furnace or its bank (or upstairs in Lumbridge Castle)?
function TSmelter.AtSite(): Boolean;
var
  me: TPoint;
begin
  if Self.Site.Lumbridge and (CurrentFloor() = 2) then
    Exit(True);
  me := Map.Position();
  Result := (me.DistanceTo(Tile(Self.Site.Furnace.X, Self.Site.Furnace.Y)) <= 30 * RSTranslator.TILE_SIZE) or
            (me.DistanceTo(Tile(Self.Site.Bank.X, Self.Site.Bank.Y)) <= 30 * RSTranslator.TILE_SIZE);
end;

procedure TSmelter.Init();
begin
  Logger.Setup('DMB''s F2P Smelter');
  ProgressReport.Setup(
    'DMB''s F2P Smelter',
    ['Script runtime:', 'Furnace:', 'Bar:', 'Bars:', 'Bars/H:', 'Total XP:', 'XP/H:'],
    @Self.GetReportValues
  );

  if not Client.IsLoggedIn() then
    DoLoginSafe();
  StartListeners(300);

  if Options.SetNPCAttack('Hidden') or Options.SetNPCAttack(3) then
    Logger.Info('NPC attack option set to hidden.');

  Self.SmithingLevel := Stats.GetLevel(ESkill.SMITHING, False);
  Inventory.Open();
  if (Self.SmithingLevel > 0) and (Self.SmithingLevel < BAR_LEVELS[Ord(Self.Bar)]) then
  begin
    if not Self.IgnoreLevels then
      raise BAR_NAMES[Ord(Self.Bar)] + ' needs ' + ToStr(BAR_LEVELS[Ord(Self.Bar)]) + ' Smithing (you have ' +
            ToStr(Self.SmithingLevel) + ').';
    Logger.Warn('DEBUG: level checks are off - ' + BAR_NAMES[Ord(Self.Bar)] + ' needs ' +
                ToStr(BAR_LEVELS[Ord(Self.Bar)]) + ' Smithing (you have ' + ToStr(Self.SmithingLevel) +
                '). The game will refuse to smelt it.');
  end;

  Logger.Info('Smithing level: ' + ToStr(Self.SmithingLevel) + '. Furnace: ' + Self.Site.Name +
              ', bank: ' + Self.Site.BankName + '. Bar: ' + BAR_NAMES[Ord(Self.Bar)] + '.');
  if Self.Bar = EBar.IRON then
    Logger.Info('Note: iron only works about half the time without a ring of forging (members).');

  // the F2P surface + the top floor of Lumbridge Castle (its bank). Two things keep WaspLib
  // placing us right on that mostly black top floor: the Wilderness row (chunk row 55) is NOT
  // loaded - it matched a black minimap better - and neither is the middle floor, which looks
  // almost the same as the top floor near the stairs.
  Logger.Info('Map: loading the areas (this can take a moment the first time).');
  Map.Setup([Chunk(Box(45, 54, 53, 48), 0), Chunk(Box(50, 50, 50, 50), 2)]);
  Map.Walker.OnWalkEvent := @Map.Walker.Watchdog;
  Map.Walker.OnWaitMovingEvent := @Map.Walker.Watchdog;
  // minimap clicks only: a game-screen click next to the Lumbridge stairs can climb them
  Map.Walker.ScreenWalk := False;

  if not NearestObject(['Furnace'], Tile(Self.Site.Furnace.X, Self.Site.Furnace.Y), 12, Self.FurnaceObj) then
    raise 'WaspLib has no furnace at ' + Self.Site.Name + '. Please post this log in a GitHub issue.';
  Logger.Info('Furnace: found at ' + Self.Site.Name + '.');

  if not Self.Site.Lumbridge then
  begin
    Self.HasBankObj := NearestObject(['Bank booth', 'Bank Booth', 'Bank chest'],
                                     Tile(Self.Site.Bank.X, Self.Site.Bank.Y), 12, Self.BankObj);
    if Self.HasBankObj then
      Logger.Info('Bank: ' + Self.Site.BankName + ' booth found.')
    else
      Logger.Warn('Bank: no booth near ' + Self.Site.BankName + ' - will use WaspLib''s nearest bank.');
  end;

  Antiban.Zoom.Min := 15;
  Antiban.Zoom.Max := 40;
  Antiban.Skills := [ESkill.SMITHING, ESkill.TOTAL];
  SlowAntiban();

  Logger.Info('Start: we are at ' + Here() + '.');
end;

// ---------------------------------------------------------------- travel

// Right-click the gate and pick the first menu line containing one of `wanted`. `menu` gets the
// whole menu (for the log). False = none of them was there (the menu is closed again).
function GateMenu(gate: TObject; wanted: TStringArray; out menu: String): Boolean;
var
  opt, pick: TOption;
  w: String;
  hovered, found: Boolean;
  tries: Integer;
begin
  menu := '';
  // a few tries; between them turn the camera a quarter turn, in case the gate is hidden
  // behind something or seen edge-on
  for tries := 1 to 4 do
  begin
    try
      hovered := gate.Hover([]);
    except
      Logger.Warn('Gate: ' + GetExceptionMessage());
    end;
    if hovered then
      Break;
    if tries < 4 then
    begin
      Logger.Info('Gate: can''t hover it from this angle - turning the camera.');
      Minimap.CompassDegrees := Round(Minimap.CompassDegrees + 90 + Random(-15, 15)) mod 360;
      Sleep(600, 1000);
    end;
  end;
  if not hovered then
  begin
    Logger.Warn('Gate: could not hover the gate (tried 4 camera angles).');
    Exit;
  end;

  Logger.Info('Gate: hovering it, hover text: "' + MainScreen.UpText + '".');

  // the hover text is read reliably ("Open Gate"); the right-click menu reader garbles letters
  // ("Ooen Gate"). So when the left-click option is already the one we want, just left-click.
  for w in wanted do
    if MainScreen.IsUpText([w], False, 0.85, 50) then
    begin
      Logger.Info('Gate: left-clicking it ("' + MainScreen.UpText + '").');
      Mouse.Click(EMouseButton.LEFT);
      Exit(True);
    end;

  Mouse.Click(EMouseButton.RIGHT);
  if not SleepUntil(ChooseOption.IsOpen(), 50, 1500) then
  begin
    Logger.Warn('Gate: the right-click menu did not open.');
    Exit;
  end;
  Sleep(150, 350);
  for opt in ChooseOption.GetOptions() do
    menu += '[' + opt.Text + '] ';
  for w in wanted do
  begin
    for opt in ChooseOption.GetOptions() do
      if Pos(Lowercase(w), Lowercase(opt.Text)) > 0 then
      begin
        pick := opt;
        found := True;
        Break;
      end;
    if found then
      Break;
  end;
  if not found then
  begin
    Logger.Info('Gate: no ' + ToStr(wanted) + ' in the menu: ' + menu);
    CancelMenu();
    Exit;
  end;
  Logger.Info('Gate: clicking "' + pick.Text + '" (menu: ' + menu + ').');
  ChooseOption.Select(pick);
  Result := True;
end;

// Through the toll gate, from whichever side we're on - by trying it, no settings needed:
//   1. "Open": with Prince Ali Rescue done it just lets us through (free). Remembered.
//   2. Not through: a guard talking to us -> with 10+ coins answer yes (pays the toll).
//   3. Still not through: "Pay-toll" (free with Prince Ali Rescue, else needs 10 coins).
//   4. Still not through / the gate hasn't got these options: we can't get through here
//      (the caller then walks the long way round the fence).
function TSmelter.CrossTollGate(): Boolean;
var
  gate: TObject;
  approach: TPoint;
  wasInside: Boolean;
  coins: Integer;
  menu: String;
  endAt: UInt64;
begin
  wasInside := InAlKharid(Map.Position());
  if wasInside then
    approach := GATE_EAST
  else
    approach := GATE_WEST;
  Logger.Info('Gate: to the toll gate.');
  if not SafeWebWalk(approach, 240000, 2) then
  begin
    Logger.Warn('Gate: could not walk to the toll gate (we are at ' + Here() + ').');
    Exit;
  end;
  Map.Walker.WaitMoving();
  SleepUntil(not Minimap.IsPlayerMoving(), 150, 5000);
  Sleep(500, 900);

  if not NearestObject(['Gate', 'Toll gate'], TOLL_GATE, 5, gate) then
  begin
    Logger.Warn('Gate: WaspLib knows no gate here - assuming we can''t get through.');
    Exit;
  end;
  coins := CoinCount();
  Logger.Info('Gate: ' + ToStr(coins) + ' coins in the inventory.');

  // 1) Open (free with Prince Ali Rescue)
  if GateMenu(gate, ['Open', 'Ooen', 'pen Gate', 'en Gate'], menu) then
  begin
    if SleepUntil(InAlKharid(Map.Position()) <> wasInside, 300, 5000) then
    begin
      Logger.Info('Gate: through for free (Prince Ali Rescue done), now at ' + Here() + '.');
      Self.FreeGate := True;
      Exit(True);
    end;

    // 2) the guard wants paying: answer yes when we have the coins, otherwise talk it out
    endAt := GetTimeRunning() + 8000;
    repeat
      if InAlKharid(Map.Position()) <> wasInside then
        Break;
      if Chat.ContainsContinue() then
        Chat.Continue()
      else if coins >= TOLL_COINS then
        Chat.Options.Select('Yes', False)
      else if not Chat.Options.Select('No', False) then
        Sleep(200);
      Sleep(400, 700);
    until GetTimeRunning() > endAt;
    if SleepUntil(InAlKharid(Map.Position()) <> wasInside, 300, 3000) then
    begin
      Logger.Info('Gate: through (paid the guard), now at ' + Here() + '.');
      Exit(True);
    end;
  end;

  // 3) Pay-toll - tried even without coins: with Prince Ali Rescue done it may be free
  if True then
    if GateMenu(gate, ['oll', 'Pay'], menu) then
      if SleepUntil(InAlKharid(Map.Position()) <> wasInside, 300, 8000) then
      begin
        Logger.Info('Gate: through (paid the toll), now at ' + Here() + '.');
        Exit(True);
      end;

  // 4) no way through here
  if coins < TOLL_COINS then
    Logger.Warn('Gate: not let through and fewer than ' + ToStr(TOLL_COINS) + ' coins - assuming we can''t get through.')
  else
    Logger.Warn('Gate: not let through (gate menu: ' + menu + ') - assuming we can''t get through.');
end;

// The long way round the fence (when the toll gate doesn't let us through).
function WalkLongWay(intoAlKharid: Boolean): Boolean;
var
  path: TPointArray;
  i, k, start: Integer;
  me: TPoint;
  best: Double;
begin
  // (written out plainly: the "if ... for ... else for ..." version left the path empty)
  SetLength(path, Length(LONG_WAY));
  for i := 0 to High(LONG_WAY) do
  begin
    k := i;
    if not intoAlKharid then
      k := High(LONG_WAY) - i;
    path[i] := Tile(LONG_WAY[k].X, LONG_WAY[k].Y);
  end;
  if Length(path) = 0 then
    Exit(False);

  me := Map.Position();
  best := 1000000000;
  for i := 0 to High(path) do
    if me.DistanceTo(path[i]) < best then
    begin
      best := me.DistanceTo(path[i]);
      start := i;
    end;
  if best > 15 * RSTranslator.TILE_SIZE then
  begin
    start := 0;
    if not SafeWebWalk(path[0], 240000, 4) then
      Exit;
  end;

  Logger.Info('Long way: walking round the fence.');
  for i := start to High(path) do
    if not SafeWebWalk(path[i], 40000, 3) then
    begin
      Logger.Warn('Long way: stuck at point ' + ToStr(i + 1) + '/' + ToStr(Length(path)) + '.');
      Exit;
    end;
  Result := InAlKharid(Map.Position()) = intoAlKharid;
end;

// From wherever we are to the furnace's bank.
procedure TSmelter.Travel();
var
  dest: TPoint;
  crossed: Boolean;
begin
  if (CurrentFloor() > 0) and not Self.Site.Lumbridge then
    if not LeaveTopFloor() then
    begin
      Inc(Self.Failures);
      Exit;
    end;

  dest := Tile(Self.Site.Bank.X, Self.Site.Bank.Y);
  Logger.Info('Travel: to ' + Self.Site.Name + ' (' + ToStr(Round(Map.Position().DistanceTo(dest) / RSTranslator.TILE_SIZE)) + ' tiles).');

  // the Lumbridge / Al Kharid fence: toll gate, or the long way round
  if InAlKharid(Map.Position()) <> InAlKharid(dest) then
  begin
    // try the gate (it finds out itself whether we pass for free or have to pay)
    crossed := Self.CrossTollGate();
    if not crossed then
    begin
      Logger.Info('Travel: the toll gate is no good - taking the long way round the fence.');
      crossed := WalkLongWay(InAlKharid(dest));
    end;
    if not crossed then
    begin
      Inc(Self.Failures);
      if Self.Failures >= 3 then
        Self.StopReason := 'Could not get past the Al Kharid fence. Please post this log in a GitHub issue.';
      Exit;
    end;
  end;

  if SafeWebWalk(dest, 300000, 8) or Self.AtSite() then
  begin
    Logger.Info('Travel: at ' + Self.Site.Name + '.');
    Self.Failures := 0;
    Exit;
  end;

  Inc(Self.Failures);
  if Self.Failures >= 3 then
    Self.StopReason := 'Could not walk to ' + Self.Site.Name + ' (we are at ' + Here() + '). Please post this log in a GitHub issue.';
end;

// ---------------------------------------------------------------- bank

procedure TSmelter.OpenBank();
var
  dest: TPoint;
  opened: Boolean;
begin
  if Self.Site.Lumbridge then
    opened := OpenLumbridgeBank()
  else
  begin
    dest := Tile(Self.Site.Bank.X, Self.Site.Bank.Y);
    if Map.Position().DistanceTo(dest) > 6 * RSTranslator.TILE_SIZE then
    begin
      if Self.Site.Name = 'Falador' then
        WalkFalador(True);
      if Map.Position().DistanceTo(dest) > 6 * RSTranslator.TILE_SIZE then
        SafeWebWalk(dest, 120000, 4);
    end;

    // the last few tiles + opening it: with the stall check and a time limit
    GuardWalk(45000);
    try
      if Self.HasBankObj then
        opened := Bank.Open(Self.BankObj, True)
      else
        opened := Bank.Open(True);
    except
      Logger.Warn('Bank: opening failed: ' + GetExceptionMessage());
      if Pos('no nodes near', GetExceptionMessage()) > 0 then
        StepToward(Tile(Self.Site.Bank.X, Self.Site.Bank.Y), 10);
    end;
    WalkDeadline := 0;
  end;

  if opened or Bank.IsOpen() then
    Exit;
  Inc(Self.Failures);
  Logger.Warn('Bank: could not open the bank (we are at ' + Here() + ').');
  if Self.Failures >= 4 then
    Self.StopReason := 'Could not open the ' + Self.Site.BankName + ' bank. Please post this log in a GitHub issue.';
end;

// Withdraw exactly `amount` with the bank's 10 / 5 / 1 buttons (typing an amount into Withdraw-X
// didn't work), or everything with QUANTITY_ALL. True when the inventory gained some.
function WithdrawOre(item: String; amount: Integer): Boolean;
var
  before, left, step: Integer;
begin
  before := Inventory.Items.Count(item);
  if amount = QUANTITY_ALL then
  begin
    if not Bank.Withdraw(new TBankItem(item, QUANTITY_ALL)) then
      Logger.Warn('Bank: WaspLib could not withdraw ' + item + '.');
  end
  else
  begin
    left := amount;
    while left > 0 do
    begin
      if left >= 10 then
        step := 10
      else if left >= 5 then
        step := 5
      else
        step := 1;
      if not Bank.Withdraw(new TBankItem(item, step)) then
      begin
        Logger.Warn('Bank: WaspLib could not withdraw ' + item + ' (' + ToStr(step) + ').');
        Break;
      end;
      left -= step;
      Sleep(150, 300);
    end;
  end;
  Result := SleepUntil(Inventory.Items.Count(item) > before, 100, 3000);
end;

// Bank the bars, then take out a full load: for two-ore bars as many sets as the free slots
// hold (the first ore counted out, the second "All" to fill the rest).
procedure TSmelter.DoBank();
var
  free, sets, have1, have2: Integer;
begin
  if Inventory.Slots.Count() > 0 then
  begin
    Self.Bars += Inventory.Items.Count(BAR_NAMES[Ord(Self.Bar)]);
    if not Bank.DepositInventory() then
      Exit;
    SleepUntil(Inventory.Slots.Count() = 0, 100, 3000);
    Inc(Self.Trips);
  end;

  free := 28 - Inventory.Slots.Count();
  if Self.Per2() = 0 then
    WithdrawOre(Self.Ore1(), QUANTITY_ALL)
  else
  begin
    sets := free div (1 + Self.Per2());
    WithdrawOre(Self.Ore1(), sets);
    WithdrawOre(Self.Ore2(), QUANTITY_ALL);
  end;

  have1 := Inventory.Items.Count(Self.Ore1());
  have2 := 0;
  if Self.Per2() > 0 then
    have2 := Inventory.Items.Count(Self.Ore2());
  if Self.Per2() > 0 then
    Logger.Info('Bank: took ' + ToStr(have1) + ' ' + Self.Ore1() + ' + ' + ToStr(have2) + ' ' + Self.Ore2() + '.')
  else
    Logger.Info('Bank: took ' + ToStr(have1) + ' ' + Self.Ore1() + '.');

  Self.DebugToBank := False;
  if (not Self.HasMaterials()) and Self.IgnoreLevels then
  begin
    // debug: no ore in the bank is fine - carry on to the furnace to test the walk there
    Logger.Warn('DEBUG: not enough ore for ' + BAR_NAMES[Ord(Self.Bar)] + ' - going to the furnace anyway.');
    Self.DebugToFurnace := True;
    Self.Failures := 0;
    Bank.Close();
    SleepUntil(not Bank.IsOpen(), 100, 3000);
    Exit;
  end;

  if not Self.HasMaterials() then
  begin
    if Self.Per2() > 0 then
      Self.StopReason := 'The bank is out of ' + Self.Ore1() + ' or ' + Self.Ore2() + ' for ' + BAR_NAMES[Ord(Self.Bar)] + '.'
    else
      Self.StopReason := 'The bank is out of ' + Self.Ore1() + ' for ' + BAR_NAMES[Ord(Self.Bar)] + '.';
    Exit;
  end;

  Self.Failures := 0;
  Bank.Close();
  SleepUntil(not Bank.IsOpen(), 100, 3000);
end;

// ---------------------------------------------------------------- furnace

procedure TSmelter.OpenFurnace();
var
  dest: TPoint;
begin
  if CurrentFloor() > 0 then
    if not LeaveTopFloor() then
    begin
      Inc(Self.Failures);
      if Self.Failures >= 4 then
        Self.StopReason := 'Could not get down the Lumbridge Castle stairs. Please post this log in a GitHub issue.';
      Exit;
    end;

  dest := Tile(Self.Site.Furnace.X, Self.Site.Furnace.Y);
  if Map.Position().DistanceTo(dest) > 6 * RSTranslator.TILE_SIZE then
  begin
    if Self.Site.Name = 'Falador' then
      WalkFalador(False);
    if Map.Position().DistanceTo(dest) > 6 * RSTranslator.TILE_SIZE then
      SafeWebWalk(dest, 120000, 4);
  end;

  GuardWalk(30000);
  try
    if Self.FurnaceObj.WalkInteract(['Smelt']) then
    begin
      Map.Walker.WaitMoving();
      if Make.WaitOpen(8000) then
      begin
        WalkDeadline := 0;
        Self.Failures := 0;
        if Self.DebugToFurnace then
        begin
          Logger.Info('DEBUG: the smelting menu opened at ' + Self.Site.Name + '. Back to the bank.');
          Self.DebugToFurnace := False;
          Self.DebugToBank := True;
        end;
        Exit;
      end;
    end;
  except
    Logger.Warn('Furnace: ' + GetExceptionMessage());
  end;
  WalkDeadline := 0;

  // debug without ore: the game won't open the menu with nothing to smelt - reaching the
  // furnace and clicking it is the test
  if Self.DebugToFurnace then
  begin
    Logger.Info('DEBUG: clicked the furnace at ' + Self.Site.Name + ' (we are at ' + Here() +
                '). No ore, so no menu. Back to the bank.');
    Self.DebugToFurnace := False;
    Self.DebugToBank := True;
    Exit;
  end;

  Inc(Self.Failures);
  Logger.Warn('Furnace: the smelting menu did not open (we are at ' + Here() + ').');
  if Self.Failures >= 5 then
    Self.StopReason := 'Could not use the furnace at ' + Self.Site.Name + '. Please post this log in a GitHub issue.';
end;

// Click the bar in the furnace menu (the game remembers "All", so one click smelts the lot).
function ClickMakeItem(item: String): Boolean;
var
  boxes: TBoxArray;
  b: TBox;
begin
  boxes := Make.GetItemBoxes();
  for b in boxes do
  begin
    Mouse.Move(b);
    if Make.WaitHint(2000) and SameText(Make.ReadHint(), item) then
    begin
      Mouse.Click(EMouseButton.LEFT);
      Exit(True);
    end;
  end;
end;

// Make.Select with a safety net: if WaspLib can't read the "All" button, use X = 28.
function SafeMakeSelect(item: String): Boolean;
begin
  try
    Exit(Make.Select(item, QUANTITY_ALL));
  except
    Logger.Warn('Make: "All" button not readable (' + GetExceptionMessage() + '). Using X = 28 instead.');
  end;
  try
    Result := Make.Select(item, 28);
  except
    Logger.Warn('Make: could not set the quantity either: ' + GetExceptionMessage());
  end;
end;

procedure TSmelter.SelectBar();
var
  before: Integer;
begin
  before := Inventory.Items.Count(Self.Ore1());
  if ClickMakeItem(BAR_NAMES[Ord(Self.Bar)]) then
    Logger.Info('Furnace: clicked ' + BAR_NAMES[Ord(Self.Bar)] + '.')
  else
  begin
    Logger.Warn('Furnace: could not find ' + BAR_NAMES[Ord(Self.Bar)] + ' by hovering, using WaspLib''s Make.Select.');
    SafeMakeSelect(BAR_NAMES[Ord(Self.Bar)]);
  end;

  // smelting has started once the ore starts disappearing
  Self.Smelting := SleepUntil(Inventory.Items.Count(Self.Ore1()) < before, 100, 5000);
  if Self.Smelting then
    Logger.Info('Furnace: smelting.')
  else
  begin
    Logger.Warn('Furnace: smelting did not start.');
    // debug with a LOCKED bar: the game won't smelt it - back to the bank and round again
    if Self.IgnoreLevels then
    begin
      Logger.Info('DEBUG: back to the bank.');
      Self.DebugToBank := True;
    end;
  end;
end;

// Still smelting while the ore keeps going down (iron fails about half the time, so watch the
// ore, not the bars).
procedure TSmelter.WaitSmelt();
var
  before: Integer;
begin
  before := Inventory.Items.Count(Self.Ore1());
  Self.Smelting := SleepUntil((Inventory.Items.Count(Self.Ore1()) < before) or not Self.HasMaterials(), 100, 6000) and
                   Self.HasMaterials();
  if Inventory.Items.Count(Self.Ore1()) < before then
    Activity.Restart();
end;

// ---------------------------------------------------------------- main loop

// Really in the Wilderness? A single position reading can be wrong (e.g. straight after the
// stairs, before the new floor has drawn), so it has to read Wilderness 3 times in a row.
function ReallyInWilderness(): Boolean;
var
  i: Integer;
begin
  for i := 1 to 3 do
  begin
    if not InWilderness(Map.Position()) then
      Exit(False);
    if i < 3 then
      Sleep(700, 900);
  end;
  Result := True;
end;

function TSmelter.GetState(): ESmelterState;
begin
  if WildernessHit or (InWilderness(Map.Position()) and ReallyInWilderness()) then
  begin
    if Self.StopReason = '' then
      Self.StopReason := 'Stopped at the Wilderness. Move the character out and restart.';
    Exit(ESmelterState.STOP);
  end;
  if Self.StopReason <> '' then
    Exit(ESmelterState.STOP);
  if Activity.IsFinished then
    Exit(ESmelterState.NO_ACTIVITY);
  if (Self.MaxTime > 0) and (Logger.TimeRunning.Elapsed >= Self.MaxTime) then
    Exit(ESmelterState.MAX_TIME);
  if not Client.IsLoggedIn() then
    Exit(ESmelterState.LOGIN);
  if Chat.LeveledUp() then
  begin
    Self.Smelting := False;
    Exit(ESmelterState.LEVEL_UP);
  end;
  if Bank.IsOpen() then
  begin
    Self.Smelting := False;
    Exit(ESmelterState.BANK);
  end;
  if not Self.AtSite() then
    Exit(ESmelterState.TRAVEL);

  // debug: furnace visit done -> bank; no ore but sent to the furnace -> furnace
  if Self.DebugToBank then
    Exit(ESmelterState.OPEN_BANK);
  if Self.DebugToFurnace and not Self.HasMaterials() then
    Exit(ESmelterState.OPEN_FURNACE);

  if Self.HasMaterials() then
  begin
    if Self.Smelting then
      Exit(ESmelterState.WAIT_SMELT);
    if Make.IsOpen() then
      Exit(ESmelterState.SELECT_BAR);
    Exit(ESmelterState.OPEN_FURNACE);
  end;

  Result := ESmelterState.OPEN_BANK;
end;

procedure TSmelter.Run();
begin
  Self.Init();

  repeat
    CloseStrayInterface();
    UnselectItem();
    Self.State := Self.GetState();
    if Self.State <> ESmelterState.WAIT_SMELT then
      Logger.Info('State: ' + ToStr(Self.State));
    ProgressReport.Print();
    WaspClient.SubmitStats();

    case Self.State of
      ESmelterState.LOGIN: DoLoginSafe();
      ESmelterState.LEVEL_UP:
        begin
          Chat.HandleLevelUp();
          Inventory.Open();
        end;
      ESmelterState.TRAVEL: Self.Travel();
      ESmelterState.OPEN_BANK: Self.OpenBank();
      ESmelterState.BANK: Self.DoBank();
      ESmelterState.OPEN_FURNACE: Self.OpenFurnace();
      ESmelterState.SELECT_BAR: Self.SelectBar();
      ESmelterState.WAIT_SMELT: Self.WaitSmelt();
      ESmelterState.OUT_OF_SUPPLIES, ESmelterState.NO_ACTIVITY,
      ESmelterState.MAX_TIME, ESmelterState.STOP: Break;
    end;

    Antiban.DoAntiban();
  until False;

  if Self.StopReason <> '' then
    Logger.Error('Stopped: ' + Self.StopReason)
  else
    Logger.Info('Stopped: ' + ToStr(Self.State));
end;

// ---------------------------------------------------------------- settings window

var
  Smelter: TSmelter;
  SmelterForm: TScriptForm;
  GuiSmithingLevel: Integer;
  RuntimeEdit: TLazEdit;
  SiteSelector, BarSelector: TLazComboBox;
  DebugBox: TLazCheckBox;
  StartLocked: String;          // set when Start is pressed on a locked bar: why it's locked

// Why a bar can't be smelted yet ('' = it can). Like the miner's LOCKED mines.
function BarLockReason(b: EBar): String;
begin
  if (GuiSmithingLevel > 0) and (GuiSmithingLevel < BAR_LEVELS[Ord(b)]) then
    Result := 'needs ' + ToStr(BAR_LEVELS[Ord(b)]) + ' Smithing (you have ' + ToStr(GuiSmithingLevel) + ')';
end;

procedure TScriptForm.OnStart(sender: TLazObject); override;
var
  minutes: Integer;
begin
  minutes := StrToInt(Trim(RuntimeEdit.Text), 60);
  if minutes < 1 then
    minutes := 60;
  Smelter.MaxTime := minutes * MINUTE;
  Smelter.Site := SITES[Max(0, SiteSelector.ItemIndex)];
  Smelter.Bar := EBar(Max(0, BarSelector.ItemIndex));
  Smelter.IgnoreLevels := DebugBox.Checked;
  if Smelter.IgnoreLevels then
    StartLocked := ''
  else
    StartLocked := BarLockReason(Smelter.Bar);
  inherited();
end;

procedure TScriptForm.Init();
var
  tab: TLazTabSheet;
  i: Integer;
  b: EBar;
  line: String;
begin
  if GuiSmithingLevel > 0 then
    Self.Setup('DMB''s F2P Smelter - Smithing ' + ToStr(GuiSmithingLevel))
  else
    Self.Setup('DMB''s F2P Smelter');
  tab := Self.CreateTab('Smelter');

  RuntimeEdit := TLazEdit.CreateEx(tab, 'Runtime (minutes):', 'How long to run, in minutes.', 40, 40, 200);
  RuntimeEdit.Text := '60';

  SiteSelector := TLazComboBox.CreateEx(tab, 'Furnace:', 'Where to smelt. The bot walks there from wherever you are.', 40, 110, 360);
  for i := 0 to High(SITES) do
    SiteSelector.Items.Add(SITES[i].Name + ' (bank: ' + SITES[i].BankName + ')');
  SiteSelector.ItemIndex := 0;

  BarSelector := TLazComboBox.CreateEx(tab, 'Bar:', 'Which bar to smelt (the Smithing level it needs). The ore must be in your bank.', 40, 180, 360);
  for b := Low(EBar) to High(EBar) do
  begin
    // every bar is listed; the ones you lack the level for say LOCKED
    line := BAR_NAMES[Ord(b)] + ' (Smithing ' + ToStr(BAR_LEVELS[Ord(b)]) + ')';
    if BarLockReason(b) <> '' then
      line += ' - LOCKED: ' + BarLockReason(b);
    BarSelector.Items.Add(line);
  end;
  BarSelector.ItemIndex := 0;

  // debugging: lets a LOCKED bar run anyway (to test walking/banking with any bar)
  DebugBox := TLazCheckBox.CreateEx(tab, 'Debug: turn off the Smithing level check',
    'For testing only. Lets you start with a LOCKED bar, and keeps going when the bank has no ore: it still walks to the furnace, clicks it and goes back to the bank, round and round.', 40, 250);

  Self.CreateAntibanTab();
  Self.CreateMiscTab();
  Self.Run();
end;

begin
  Logger.Info('*** Make sure your settings match the WaspLib suggested settings (Fixed - Classic layout, the right RuneLite profile). Wrong settings make the bot misread the screen. ***');
  SetupSites();

  Logger.Info('Reading your Smithing level before opening the settings...');
  try
    if not Client.IsLoggedIn() then
      DoLoginSafe();
    GuiSmithingLevel := Stats.GetLevel(ESkill.SMITHING, False);
    Inventory.Open();
  except
    Logger.Warn('Could not read the Smithing level: ' + GetExceptionMessage());
    GuiSmithingLevel := 0;
  end;

  SmelterForm.Init();
  SetClientInputLocked(True);
  try
    if StartLocked <> '' then
      Logger.Error(BAR_NAMES[Ord(Smelter.Bar)] + ' is locked: ' + StartLocked +
                   '. Pick another bar (or tick the debug box to run it anyway).')
    else
      Smelter.Run();
  finally
    SetClientInputLocked(False);
  end;
end.
